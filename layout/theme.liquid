  {% comment %} <script>
(function () {
  console.log('[Upsell] Direct Drawer Refresh Mode');
  async function getCart() {
    const res = await fetch('/cart.js');
    return res.json();
  }
  async function refreshDrawer() {
    const drawer = document.querySelector('cart-drawer-component');
    if (!drawer) {
      console.warn('[Upsell] Drawer not found');
      return;
  
    }
    console.log('[Upsell] Drawer instance:', drawer);
    // Try known public methods used in OS2 themes
    if (typeof drawer.renderContents === 'function') {
      console.log('[Upsell] renderContents()');
      const cart = await getCart();
      drawer.renderContents(cart);
    }
    else if (typeof drawer.load === 'function') {
      console.log('[Upsell] load()');
      drawer.load();
    }
    else if (typeof drawer.refresh === 'function') {
      console.log('[Upsell] refresh()');
      drawer.refresh();
    }
    else {
      console.warn('[Upsell] No public refresh method — forcing click on cart icon');
      // Fallback: simulate theme cart icon click (forces internal refresh)
      const cartButton = document.querySelector('[data-testid="cart-drawer-trigger"]');
      if (cartButton) cartButton.click();
    }
    // Ensure open
    if (typeof drawer.open === 'function') {
      drawer.open();
    } else {
      drawer.setAttribute('open', '');
    }
  }
  async function addUpsell(variantId, button) {
    button.disabled = true;
    const original = button.textContent;
    button.textContent = 'Adding…';
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      });
      if (!res.ok) throw new Error('Add failed');
      console.log('✅ Upsell added');
      await refreshDrawer();
      button.textContent = 'Added ✓';
    } catch (err) {
      console.error('[Upsell] Error:', err);
      button.textContent = 'Error';
    }
    setTimeout(() => {
      button.textContent = original;
      button.disabled = false;
    }, 1500);
  }
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.cart-upsell__add');
    if (!btn) return;
    const wrapper = btn.closest('[data-upsell-item]');
    if (!wrapper) return;
    const select = wrapper.querySelector('.cart-upsell__variant');
    const variantId = select ? select.value : btn.dataset.variantId;
    if (!variantId) {
      console.error('[Upsell] Variant ID missing');
      return;
    }
    addUpsell(variantId, btn);
  });
})();
</script>  {% endcomment %}
<script>
document.addEventListener('click', async function (e) {
  const btn = e.target.closest('.cart-upsell__add');
  if (!btn) return;
  const item = btn.closest('[data-upsell-item]');
  const select = item.querySelector('.cart-upsell__variant');
  const variantId = select ? select.value : btn.dataset.variantId;
  if (!variantId) return;
  btn.disabled = true;
  btn.textContent = 'Adding…';
  try {
    // 🛒 Add item
    await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    });
    console.log('✅ Upsell added');
    // 🔍 Find cart items component
    const cartComponent = document.querySelector('cart-items-component');
    if (!cartComponent) {
      console.warn('cart-items-component not found');
      return;
    }
    const sectionId = cartComponent.dataset.sectionId;
    if (!sectionId) {
      console.warn('Section ID missing on cart-items-component');
      return;
    }
    console.log('🔄 Refreshing section:', sectionId);
    // 🔄 Request updated section HTML from Shopify
    const res = await fetch(`/?sections=${sectionId}`);
    const data = await res.json();
    if (!data[sectionId]) {
      console.warn('Section HTML not returned');
      return;
    }
    // 🧩 Parse new HTML
    const parser = new DOMParser();
    const doc = parser.parseFromString(data[sectionId], 'text/html');
    const newComponent = doc.querySelector('cart-items-component');
    if (!newComponent) {
      console.warn('New cart-items-component not found in response');
      return;
    }
    // ♻️ Replace ONLY inner content (keeps drawer open)
    cartComponent.innerHTML = newComponent.innerHTML;
    console.log('🛒 Cart drawer content fully refreshed');
    // 🧠 Let theme re-bind events if it uses Web Components lifecycle
    if (cartComponent.connectedCallback) {
      cartComponent.connectedCallback();
    }
  } catch (err) {
    console.error('Upsell error:', err);
  }
  btn.disabled = false;
  btn.textContent = 'Add';
});
</script>

    <script>
