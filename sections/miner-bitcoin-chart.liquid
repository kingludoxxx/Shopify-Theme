<section class="btc-chart-section" id="BtcChart-{{ section.id }}">
  <div class="btc-chart-container">
    <h2 class="sr-only">{{ section.settings.heading }}</h2>
    
    <div class="chart-header">
      <p class="price-stat">{{ section.settings.price_text }}</p>
      <p class="sub-stat">{{ section.settings.sub_text }}</p>
    </div>

    <div class="chart-wrapper">
      <div class="image-container">
        {% if section.settings.chart_desktop != blank %}
          <img src="{{ section.settings.chart_desktop | image_url: width: 1200 }}" alt="Chart" class="chart-desktop">
        {% endif %}
        {% if section.settings.chart_mobile != blank %}
          <img src="{{ section.settings.chart_mobile | image_url: width: 600 }}" alt="Chart" class="chart-mobile">
        {% endif %}
      </div>

      <ul class="chart-points">
        {% for block in section.blocks %}
          <li class="point-item" style="--left-mb: {{ block.settings.left_mb }}rem; --bottom-mb: {{ block.settings.bottom_mb }}rem; --left-dt: {{ block.settings.left_dt }}rem; --bottom-dt: {{ block.settings.bottom_dt }}rem;">
            <button class="point-trigger" data-popup-index="{{ forloop.index0 }}" data-active="false">
              <img src="{{ block.settings.avatar | image_url: width: 100 }}" alt="{{ block.settings.name }}" class="avatar-img">
              {% comment %} <div class="dot-indicator"></div> {% endcomment %}
            </button>
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="timeline-years">
      <span>2009</span>
      <span>2025</span>
    </div>

    <div class="chart-footer">
      <span class="price-label">$0</span>
      <a href="{{ section.settings.btn_url }}" class="btn-cart desktop-view">{{ section.settings.btn_text }}</a>
      <span class="price-label">$100,000+</span>
    </div>
    <a href="{{ section.settings.btn_url }}" class="btn-cart mobile-view">{{ section.settings.btn_text }}</a>
  </div>

  <div class="popups-overlay">
    {% for block in section.blocks %}
      <div class="chart-popup" data-popup-index="{{ forloop.index0 }}" data-active="false">
        <div class="popup-content">
          <img src="{{ block.settings.popup_image | image_url: width: 400 }}" alt="" class="popup-main-img">
          <div class="popup-details">
            <blockquote class="popup-quote">
              {{ block.settings.quote }}
              <cite>{{ block.settings.name }}</cite>
            </blockquote>
            <p class="popup-desc">{{ block.settings.description }}</p>
            <div class="popup-stats">
              <div>
                <span class="stat-label">Year</span>
                <span class="stat-value">{{ block.settings.year }}</span>
              </div>
              <div>
                <span class="stat-label">BTC Price</span>
                <span class="stat-value">{{ block.settings.btc_price }}</span>
              </div>
            </div>
            <button class="popup-close-btn">Close</button>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('#BtcChart-{{ section.id }}');
  const triggers = section.querySelectorAll('.point-trigger');
  const popups = section.querySelectorAll('.chart-popup');
  const closeBtns = section.querySelectorAll('.popup-close-btn');

  triggers.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const index = btn.dataset.popupIndex;
      popups.forEach(p => p.setAttribute('data-active', 'false'));
      section.querySelector(`.chart-popup[data-popup-index="${index}"]`).setAttribute('data-active', 'true');
    });
  });

  // Close when clicking overlay or close button
  section.querySelectorAll('.chart-popup, .popup-close-btn').forEach(el => {
    el.addEventListener('click', (e) => {
      if (e.target === el || el.classList.contains('popup-close-btn')) {
        popups.forEach(p => p.setAttribute('data-active', 'false'));
      }
    });
  });
});
</script>


<style>
    .btc-chart-section {
    position: relative;
    margin-top: 4rem;
    margin-bottom: 4rem;
    margin-left: 2rem;
    margin-right: 2rem;
    padding: 2rem 1rem;
    background-color: #f5f5f5;
    border-radius: 2.5rem;
    font-family: 'Manrope', sans-serif;
    }

    .btc-chart-container { max-width: 1400px; padding: 0px 30px; margin: 0 auto; position: relative; }

    .chart-header { text-align: center; z-index: 1; margin-bottom: 2rem; }
    @media (min-width: 768px) {
    .chart-header { position: absolute; text-align: left; }
    }

    .price-stat { color: #8A8F9C; font-size: 2.7rem; font-weight: 800; margin: 0; }
    .sub-stat { color: #000; font-size: 1.5rem; font-weight: 600; margin-top: 0.5rem; }

    .chart-wrapper { position: relative; margin-top: 1rem; }
    .chart-mobile { display: block; width: 100%; aspect-ratio: 300/340; }
    .chart-desktop { display: none; width: 100%; }

    @media (min-width: 768px) {
    .chart-mobile { display: none; }
    .chart-desktop { display: block; aspect-ratio: 1200/430; }
    }

    /* Points logic */
    .chart-points { list-style: none; padding: 0; margin: 0; }
    .point-item { position: absolute; left: var(--left-mb); bottom: var(--bottom-mb); }
    @media (min-width: 768px) {
    .point-item { left: var(--left-dt); bottom: var(--bottom-dt); }
    }

    .point-trigger {
    background: none; border: none; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
    }
    .avatar-img {
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    border: 2px solid #8E8E8E; object-fit: cover;
    }
    .dot-indicator {
    width: 0.5rem; height: 0.5rem; background: #8E8E8E; border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(255,121,27,0.2);
    }

    /* Popups */
    .chart-popup {
    position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: 0.3s; padding: 1rem;
    }
    .chart-popup[data-active="true"] { opacity: 1; pointer-events: auto; }

    .popup-content {
    background: #1a1a1a; color: #fff; border-radius: 1.25rem;
    max-width: 600px; width: 100%; display: flex; flex-direction: column; overflow: hidden;
    }
    .popup-close-btn{padding: 10px;font-family: 'Plus Jakarta Sans';margin-top: 10px;}
    @media (min-width: 768px) { .popup-content { flex-direction: row; } }

    @media (max-width: 768px) { 
        .btc-chart-container{
            padding: 0px 0px !important; 
        }
        .price-stat{
            font-size: 1.7rem !important;
        } 
        .sub-stat{
            font-size: 1.2rem !important;
        }
        .btc-chart-section{
            margin: 1.5rem 1rem !important;
        }
        .mobile-view{
        display: block !important;
        }
        .desktop-view{
            display: none !important;
        }
        .chart-footer{
            margin-top: 0px !important;
        }
        .btn-cart{
            text-align: center;
            margin-top: 1rem;
        }
    }
    .mobile-view{
        display: none;
    }

    .popup-main-img { width: 100%; height: 250px; object-fit: cover; }
    @media (min-width: 768px) { .popup-main-img { width: 220px; height: 300px; } }

    .popup-details { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; }
    .popup-quote { font-style: italic; font-size: 0.9rem; margin: 0 0 1rem; color: #ccc; }
    .popup-quote cite { display: block; font-style: normal; font-weight: bold; color: #fff; margin-top: 0.5rem; }
    .popup-desc { font-size: 0.75rem; color: #888; }
    .popup-stats { display: flex; gap: 2rem; margin-top: auto; padding-top: 1rem; }
    .stat-label { display: block; font-size: 0.7rem; color: #888; text-transform: uppercase; }
    .stat-value { font-weight: bold; font-size: 1.1rem; }

    .btn-cart {
    background: #000; color: #fff; padding: 1rem 2.5rem; border-radius: 0.5rem;
    text-decoration: none; font-weight: bold; transition: 0.3s;
    }
    .timeline-years, .chart-footer {
    display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;
    }
    .price-label { font-weight: 800; font-size: 1.5rem; }
</style>


{% schema %}
{
  "name": "Bitcoin Chart Section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chart" },
    { "type": "text", "id": "price_text", "label": "Price Text", "default": "≈ $100 / year" },
    { "type": "inline_richtext", "id": "sub_text", "label": "Subtext", "default": "in Bitcoin" },
    { "type": "image_picker", "id": "chart_desktop", "label": "Chart Desktop" },
    { "type": "image_picker", "id": "chart_mobile", "label": "Chart Mobile" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Add to cart" },
    { "type": "url", "id": "btn_url", "label": "Button Link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Chart Point",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar Icon" },
        { "type": "header", "content": "Mobile Position (rem)" },
        { "type": "number", "id": "left_mb", "label": "Left Offset", "default": 5 },
        { "type": "number", "id": "bottom_mb", "label": "Bottom Offset", "default": 2 },
        { "type": "header", "content": "Desktop Position (rem)" },
        { "type": "number", "id": "left_dt", "label": "Left Offset", "default": 10 },
        { "type": "number", "id": "bottom_dt", "label": "Bottom Offset", "default": 5 },
        { "type": "header", "content": "Popup Content" },
        { "type": "image_picker", "id": "popup_image", "label": "Popup Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Michael Saylor" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "year", "label": "Year", "default": "2020" },
        { "type": "text", "id": "btc_price", "label": "BTC Price", "default": "$10,000" }
      ]
    }
  ],
  "presets": [{ "name": "Bitcoin Progression Chart" }]
}
{% endschema %}