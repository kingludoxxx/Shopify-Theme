{% comment %}
  MineBlock Track My Order Section
  Features: Loading states, Hidden-by-default results, Responsive design
{% endcomment %}

<style>
  .mb-track-{{ section.id }} {
    padding: 40px 10px;
    background-color: transparent;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .mb-track-container {
    max-width: 800px;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 2.5rem;
    padding: 40px 20px;
    color: #000000;
    border: 1px solid #ffffff;
  }

  @media (min-width: 768px) {
    .mb-track-container {
      padding: 60px 80px;
    }
  }

  .mb-track-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .mb-track-header h2 {
    font-size: 32px;
    font-weight: 800;
    margin: 0 0 10px 0;
    letter-spacing: -1px;
  }

  .mb-track-header p {
    color: #888;
    font-size: 16px;
  }

  /* Form Styles */
  .mb-track-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .mb-track-input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mb-track-input {
    background: #fafafa;
    border: 1px solid #333;
    padding: 16px;
    border-radius: 12px;
    color: #000;
    font-size: 16px;
    outline: none;
    transition: border-color 0.3s;
  }

  .mb-track-input:focus {
    border-color: #FF6900;
  }

  .mb-track-submit {
    background-color:rgb(0, 0, 0);
    color:rgb(255, 255, 255);
    padding: 18px;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    margin-top: 10px;
    transition: opacity 0.3s;
    text-transform: uppercase;
    letter-spacing: 0px;
  }

  .mb-track-submit:hover {
    opacity: 0.9;
  }

  /* Results Styles (Hidden by Default) */
  #track-results-{{ section.id }} {
    display: none;
    margin-top: 50px;
    padding-top: 40px;
    border-top: 1px solid #222;
    animation: fadeIn 0.5s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mb-status-bar {
    display: flex;
    justify-content: space-between;
    margin-bottom: 40px;
    position: relative;
  }

  .mb-status-bar::before {
    content: "";
    position: absolute;
    top: 15px;
    left: 0;
    right: 0;
    height: 2px;
    background: #222;
    z-index: 1;
  }

  .mb-status-step {
    position: relative;
    z-index: 2;
    text-align: center;
    width: 25%;
  }

  .mb-status-dot {
    width: 32px;
    height: 32px;
    background: #111;
    border: 2px solid #333;
    border-radius: 50%;
    margin: 0 auto 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  .mb-status-step.active .mb-status-dot {
    background: #FF6900;
    border-color: #FF6900;
    box-shadow: 0 0 15px rgba(255, 105, 0, 0.4);
  }

  .mb-status-step.completed .mb-status-dot {
    background: #fff;
    border-color: #fff;
    color: #000;
  }

  .mb-status-label {
    font-size: 12px;
    font-weight: 700;
    color: #666;
    text-transform: uppercase;
  }

  .active .mb-status-label { color: #fff; }

  .mb-order-info {
    background: #111;
    padding: 25px;
    border-radius: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .info-label { color: #555; font-size: 12px; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 5px; }
  .info-value { color: #fff; font-size: 18px; font-weight: 600; }

  /* Loading Spinner */
  .mb-loader {
    display: none;
    margin: 30px auto;
    width: 40px;
    height: 40px;
    border: 3px solid #222;
    border-radius: 50%;
    border-top-color: #FF6900;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<section class="mb-track-{{ section.id }}">
  <div class="mb-track-container">
    <div class="mb-track-header">
      <h2>{{ section.settings.heading }}</h2>
      {% comment %} <p>{{ section.settings.subheading }}</p> {% endcomment %}
    </div>

    <form class="mb-track-form" id="track-form-{{ section.id }}">
      <div class="mb-track-input-group">
        <input type="text" class="mb-track-input" placeholder="Order Number (e.g. #1001)" required>
      </div>
      <div class="mb-track-input-group">
        <input type="email" class="mb-track-input" placeholder="Email Address" required>
      </div>
      <button type="submit" class="mb-track-submit">
        {{ section.settings.button_text }}
      </button>
    </form>

    <div class="mb-loader" id="track-loader-{{ section.id }}"></div>

    <div id="track-results-{{ section.id }}">
      <div class="mb-status-bar">
        <div class="mb-status-step completed">
          <div class="mb-status-dot">✓</div>
          <span class="mb-status-label">Confirmed</span>
        </div>
        <div class="mb-status-step completed">
          <div class="mb-status-dot">✓</div>
          <span class="mb-status-label">Processing</span>
        </div>
        <div class="mb-status-step active">
          <div class="mb-status-dot">3</div>
          <span class="mb-status-label">Shipped</span>
        </div>
        <div class="mb-status-step">
          <div class="mb-status-dot">4</div>
          <span class="mb-status-label">Delivered</span>
        </div>
      </div>

      <div class="mb-order-info">
        <div>
          <span class="info-label">Current Status</span>
          <span class="info-value">In Transit</span>
        </div>
        <div>
          <span class="info-label">Estimated Delivery</span>
          <span class="info-value">Oct 24 - Oct 27</span>
        </div>
        <div>
          <span class="info-label">Carrier</span>
          <span class="info-value">DHL Express</span>
        </div>
        <div>
          <span class="info-label">Last Location</span>
          <span class="info-value">Sorting Hub, New York</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('track-form-{{ section.id }}').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const loader = document.getElementById('track-loader-{{ section.id }}');
    const results = document.getElementById('track-results-{{ section.id }}');
    const form = this;

    // Show Loader
    loader.style.display = 'block';
    results.style.display = 'none';
    form.style.opacity = '0.5';
    form.style.pointerEvents = 'none';

    // Simulate API Delay
    setTimeout(() => {
      loader.style.display = 'none';
      results.style.display = 'block';
      form.style.opacity = '1';
      form.style.pointerEvents = 'auto';
      
      // Scroll to results
      results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 1500);
  });
</script>

{% schema %}
{
  "name": "Track My Order",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Track Your Package"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Enter your details to see real-time updates on your MinerForge Pro."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Track Order"
    }
  ],
  "presets": [
    {
      "name": "Track My Order"
    }
  ]
}
{% endschema %}