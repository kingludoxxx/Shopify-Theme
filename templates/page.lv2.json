          "blocks": {}
        },
        "b3": {
          "type": "text",
          "settings": {
            "text": "<p>\ud83d\udc65 <strong>Multiple units stack your odds linearly.</strong> One unit gives you 144 attempts per day. Five give you 720. Ten give you 1,440. The math is clean and the cost to run them is negligible.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
