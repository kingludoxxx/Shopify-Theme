            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "b1": {
          "type": "text",
          "settings": {
            "text": "<p>\u26a1 <strong>The window is open right now.</strong> The Bitcoin network pays out a 3.125 BTC reward every ten minutes \u2014 and that number cuts in half on a schedule. The current payout window is the largest you'll see for years.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
