          "blocks": {}
        },
        "b2": {
          "type": "text",
          "settings": {
            "text": "<p>\ud83d\udee1 <strong>Setup is the entire barrier.</strong> Most people don't try this because they assume it's complicated. It isn't. If you can plug in a phone charger, you can run a Miner Forge Pro.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
