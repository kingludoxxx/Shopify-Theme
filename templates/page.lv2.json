          "blocks": {}
        },
        "intro": {
          "type": "text",
          "settings": {
            "text": "<p>The people doing well with this aren't the loud ones online. They're the quiet ones who bought two, three, four units and forgot about them. Here's what they understand that most people don't.</p>",
            "width": "100%",
            "max_width": "normal",
