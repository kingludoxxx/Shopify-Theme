          "blocks": {}
        },
        "b4": {
          "type": "text",
          "settings": {
            "text": "<p>\u26a1 <strong>It runs forever.</strong> No expiration. No subscription. No recurring fees. You buy the device, plug it in, and it keeps trying for as long as you let it.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
