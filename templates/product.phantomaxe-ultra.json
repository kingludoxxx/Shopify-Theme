        "text_UDegeE": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p><strong>Start Bitcoin mining with peace of mind. Test the PhantomAxe Ultra for 90 days — if it’s not for you, return it. Every unit also comes with lifetime warranty coverage.</strong></p>",
