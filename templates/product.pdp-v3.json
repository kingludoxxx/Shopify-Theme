              },
              "blocks": {
                "text_Wj8UhR": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>No. There are no subscriptions or hidden costs. Once you purchase the hardware, you own it, and all hashing power is directed to your chosen address.</p>",
                    "width": "100%",
                    "max_width": "none",
