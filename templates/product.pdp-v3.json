    "miner_tabs_section_pxqJpj": {
      "type": "miner-tabs-section",
      "blocks": {
        "tab_H9GiKt": {
          "type": "tab",
          "settings": {
            "tab_label": "How It Works",
            "media_type": "image",
            "video_url": "https://cdn.shopify.com/videos/c/o/v/575f631273f54a8392d253f56a032134.mp4",
            "tab_heading": "Seamless Setup",
            "tab_content": "Our plug-and-play device is designed to connect directly to the Bitcoin network for educational and exploratory purposes. It allows users to observe network activity, understand how blockchain data is processed, and gain insight into how decentralized systems function in real time.\n\nUnlike traditional setups that require complex configuration or third-party services, Forge Pro operates independently as a self-contained device focused on learning, experimentation, and technical exploration. All activity performed by the device is non-custodial and transparent, with no guarantees of outcomes or results.\n\nNo technical expertise is required. Simply connect the device to your Wi-Fi network and enter a public Bitcoin address to enable network interaction features and begin exploring how the system operates."
          }
        },
        "tab_jxceCY": {
          "type": "tab",
          "settings": {
            "tab_label": "The Tech",
            "media_type": "image",
            "video_url": "",
            "tab_heading": "Advanced Architecture",
            "tab_content": "Powered by the 2025 ESP32-D0 processing chip, the MinerForge Pro is engineered for high-efficiency computation in a compact form factor. Our proprietary firmware utilizes adaptive logic to target network block signatures efficiently.\n<br><br>\nExperience a streamlined mining interface with integrated hardware management designed specifically for the solo mining enthusiast."
          }
        },
        "tab_4G9xpb": {
          "type": "tab",
          "settings": {
            "tab_label": "Efficiency",
            "media_type": "image",
            "video_url": "https://cdn.shopify.com/videos/c/o/v/f49e392ae8ce4973af05a38149f875b8.mp4",
            "tab_heading": "Eco-Friendly Design",
            "tab_content": "The MinerForge Pro is designed for 24/7 operation with a focus on sustainability. Consuming just 1W of power (~0.72 kWh per month), it allows you to participate in the Bitcoin ecosystem for less than the cost of a standard LED light bulb.\n<br><br>\nEnjoy a silent, heat-free experience with minimal impact on your utility bill. It is a sustainable way to maintain a continuous connection to the Bitcoin network."
          }
        }
      },
