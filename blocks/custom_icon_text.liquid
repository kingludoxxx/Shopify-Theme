<div class="product-icons">
    <div class="product-icon-item">    
      {% if block.settings.icon != blank %}
        <img src="{{ block.settings.icon | image_url }}" alt="{{ block.settings.heading }}" width="24" height="24" >
      {% endif %}
      {% if block.settings.heading != blank %}
        <span>{{ block.settings.heading }}</span>
      {% endif %}
    </div>
</div>

<style>
.product-icons {
  display: flex;
  align-items: center;
  gap: 30px;
  background: #2f2f2f;
  padding: 12px 20px;
}

.product-icon-item {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}

.product-icon-item img {
  width: 24px;
  height: 24px;
  object-fit: contain;
}
</style>

{% schema %}
{
  "name": "Custom Product Icons",
  "settings": [
    {
        "type": "image_picker",
        "id": "icon",
        "label": "Icon"
    },
    {
        "type": "text",
        "id": "heading",
        "label": "Text",
        "default": "Secure Checkout"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Icons",
    }
  ]
}
{% endschema %}