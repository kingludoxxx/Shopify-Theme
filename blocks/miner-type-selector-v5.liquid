{%- comment -%}
  Miner Type Selector V5 (split test for /products/pdp-v5)
  ----------------------------------------------------------
  Renders 3 pill buttons that let the visitor switch between three
  Mineblock products IN-PLACE on the pdp-v5 page (no navigation):
    - 'pdp-v5'        Miner Forge PRO  (page native)
    - 'bitaxe-gamma'  Bitaxe Gamma Shot
    - 'titan-max'     Titan Max

  Click on a pill dispatches a `mb:miner-changed` CustomEvent that
  blocks/bundle-selector-v5.liquid listens for to swap variant IDs +
  prices in its bundle UI.

  Below the pills, a "What's the difference?" button opens a modal
  with one column per miner (image + title + 1-sentence description).
  Image src is pulled live from each product's featured_image so it
  stays in sync with whatever the operator sets in Shopify Admin.

  Mineblock theme colors only — no orange-gradient styling from
  the competitor reference.
{%- endcomment -%}

{%- assign mb_v5 = all_products['pdp-v5'] -%}
{%- assign mb_bx = all_products['bitaxe-gamma'] -%}
{%- assign mb_tm = all_products['titan-max'] -%}

<div class="mb-mtype" data-mb-mtype>
  <div class="mb-mtype__label">Choose your miner</div>
  <div class="mb-mtype__pills" role="radiogroup" aria-label="Choose your miner">
    <button type="button" class="mb-mtype__pill is-active" data-handle="pdp-v5" aria-checked="true">
      Miner Forge PRO
    </button>
    <button type="button" class="mb-mtype__pill" data-handle="bitaxe-gamma" aria-checked="false">
      Bitaxe Gamma Shot
    </button>
    <button type="button" class="mb-mtype__pill" data-handle="titan-max" aria-checked="false">
      Titan Max
    </button>
  </div>

  <button type="button" class="mb-mtype__diff-btn" data-mb-open-popup>
    What's the difference?
  </button>
</div>

<div class="mb-mtype-popup" data-mb-popup hidden role="dialog" aria-modal="true" aria-labelledby="mb-mtype-popup-title">
  <div class="mb-mtype-popup__backdrop" data-mb-popup-close aria-hidden="true"></div>
  <div class="mb-mtype-popup__panel" role="document">
    <button type="button" class="mb-mtype-popup__close" data-mb-popup-close aria-label="Close">&times;</button>
    <h2 id="mb-mtype-popup-title" class="mb-mtype-popup__sr">Compare miners</h2>
    <div class="mb-mtype-popup__cols">
      <div class="mb-mtype-popup__col">
        {% if mb_v5.featured_image %}
          <img class="mb-mtype-popup__img"
               src="{{ mb_v5.featured_image | image_url: width: 480 }}"
               alt="Miner Forge PRO"
               loading="lazy" width="480" height="480">
        {% endif %}
        <h3 class="mb-mtype-popup__title">Miner Forge PRO</h3>
        <p class="mb-mtype-popup__desc">Entry-level Bitcoin solo-mining device, designed for learning and small-scale experimentation.</p>
      </div>

      <div class="mb-mtype-popup__col">
        {% if mb_bx.featured_image %}
          <img class="mb-mtype-popup__img"
               src="{{ mb_bx.featured_image | image_url: width: 480 }}"
               alt="Bitaxe Gamma Shot"
               loading="lazy" width="480" height="480">
        {% endif %}
        <h3 class="mb-mtype-popup__title">Bitaxe Gamma Shot</h3>
        <p class="mb-mtype-popup__desc">Mid-tier miner running at 1.2 TH/s &mdash; over a trillion hash attempts per second to solve the block.</p>
      </div>

      <div class="mb-mtype-popup__col">
        {% if mb_tm.featured_image %}
          <img class="mb-mtype-popup__img"
               src="{{ mb_tm.featured_image | image_url: width: 480 }}"
               alt="Titan Max"
               loading="lazy" width="480" height="480">
        {% endif %}
        <h3 class="mb-mtype-popup__title">Titan Max</h3>
        <p class="mb-mtype-popup__desc">Top-tier home miner reaching up to 5 TH/s &mdash; five trillion hash attempts per second to solve the block.</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* === Miner type selector =========================================== */
  .mb-mtype {
    margin: 18px 0 14px;
    font-family: 'Manrope', sans-serif;
    text-align: center;   /* centers the "What's the difference?" button */
  }
  .mb-mtype__label {
    font-size: 14px;
    font-weight: 700;
    color: #000;
    margin-bottom: 10px;
    letter-spacing: .01em;
    text-align: center;
  }
  .mb-mtype__pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .mb-mtype__pill {
    flex: 1 1 0;
    min-width: 110px;
    padding: 12px 14px;
    border-radius: 999px;
    border: 2px solid rgba(0, 0, 0, .18);
    background: #fff;
    cursor: pointer;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    color: #000;
    transition: background .15s ease, border-color .15s ease, color .15s ease;
    text-align: center;
  }
  .mb-mtype__pill:hover {
    border-color: #1126a5;
  }
  .mb-mtype__pill.is-active {
    background: #1126a5;
    color: #fff;
    border-color: #1126a5;
  }
  .mb-mtype__pill:focus-visible {
    outline: 2px solid #1126a5;
    outline-offset: 2px;
  }

  .mb-mtype__diff-btn {
    margin: 14px 0 0;
    display: inline-block;
    padding: 10px 22px;
    border: none;
    border-radius: 999px;
    background: #1126a5;
    color: #fff;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-decoration: underline;
    cursor: pointer;
    transition: background .15s ease, transform .1s ease, box-shadow .15s ease;
  }
  .mb-mtype__diff-btn:hover {
    background: #0a177c;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, .18);
  }
  .mb-mtype__diff-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  /* Mobile: stack the variant pills vertically — one full-width pill
     per row, matching the operator's reference layout. Bigger touch
     targets, easier to tap on narrow screens. */
  @media (max-width: 600px) {
    .mb-mtype__pills {
      flex-direction: column;
      gap: 10px;
    }
    .mb-mtype__pill {
      width: 100%;
      min-width: 0;
      flex: none;
      font-size: 16px;
      padding: 16px 14px;
    }
    .mb-mtype__diff-btn { font-size: 13px; padding: 10px 22px; }
  }

  /* === Popup ========================================================= */
  /* Flexbox centering on a fixed-positioned full-viewport overlay so the
     panel sits perfectly in the middle of the screen, both horizontally
     and vertically, regardless of scroll position or parent layout. */
  .mb-mtype-popup {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }
  .mb-mtype-popup:not([hidden]) { display: flex; }

  .mb-mtype-popup__backdrop {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(0, 0, 0, .65);
    backdrop-filter: blur(2px);
  }

  .mb-mtype-popup__panel {
    position: relative;
    width: 100%;
    max-width: 1100px;
    margin: auto;            /* belt-and-suspenders centering on top of flex */
    background: #fff;
    border-radius: 16px;
    padding: 36px 28px 28px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .4);
    font-family: 'Manrope', sans-serif;
    max-height: 88vh;
    overflow-y: auto;
  }
  @media (max-width: 740px) {
    .mb-mtype-popup__panel {
      padding: 36px 18px 22px;
      border-radius: 14px;
      max-height: 92vh;
    }
  }

  .mb-mtype-popup__close {
    position: absolute;
    top: 8px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    font-size: 28px;
    line-height: 1;
    color: #000;
    cursor: pointer;
    border-radius: 999px;
    transition: background .15s ease;
  }
  .mb-mtype-popup__close:hover { background: rgba(0, 0, 0, .07); }

  .mb-mtype-popup__sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;
  }

  .mb-mtype-popup__cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  @media (min-width: 740px) {
    .mb-mtype-popup__cols { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }

  .mb-mtype-popup__col {
    text-align: center;
  }

  .mb-mtype-popup__img {
    width: 100%;
    max-width: 280px;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 14px;
    margin: 0 auto 14px;
    display: block;
    background: #f7f7f7;
  }

  .mb-mtype-popup__title {
    color: #1126a5;
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 22px;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .mb-mtype-popup__desc {
    color: #2b2b2b;
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    max-width: 320px;
    margin: 0 auto;
  }

  /* Lock body scroll while popup is open */
  body.mb-mtype-popup-open { overflow: hidden; }
</style>

<script>
(function () {
  if (window.__MB_MINER_TYPE_V5_INSTALLED__) return;
  window.__MB_MINER_TYPE_V5_INSTALLED__ = true;

  // === Per-miner bullet copy =========================================
  // The product page's existing icon-text block contains the static
  // bullets. We don't replace the block (operator wants the original
  // ✓/<em>/<strong> icon styling preserved); instead we swap its inner
  // HTML when the visitor clicks a different miner pill. Each miner's
  // copy uses the same <p><em>✓</em> <strong>...</strong></p> shape so
  // the existing site-wide CSS continues to style them.
  var BULLETS_BY_MINER = {
    'pdp-v5':
      '<p><em>✓</em> <strong>Get a chance to win 3 BTC ($300,000)</strong></p>' +
      '<p><em>✓</em> <strong>Costs just $1/year to run</strong></p>' +
      '<p><em>✓</em> <strong>Plug in, set &amp; forget</strong></p>' +
      '<p><em>✓</em> <strong>Lifetime warranty</strong></p>',
    'bitaxe-gamma':
      '<p><em>✓</em> <strong>Get a chance to win 3 BTC ($300,000)</strong></p>' +
      '<p><em>✓</em> <strong>Costs just $20/year to run</strong></p>' +
      '<p><em>✓</em> <strong>720 automatic attempts to solve a block</strong></p>' +
      '<p><em>✓</em> <strong>Plug in, set &amp; forget</strong></p>' +
      '<p><em>✓</em> <strong>Lifetime warranty</strong></p>',
    'titan-max':
      '<p><em>✓</em> <strong>Get a chance to win 3 BTC ($300,000)</strong></p>' +
      '<p><em>✓</em> <strong>2280 automatic attempts to solve a block</strong></p>' +
      '<p><em>✓</em> <strong>4.8 TH/s of consistent Bitcoin mining output</strong></p>' +
      '<p><em>✓</em> <strong>4 &times; Antminer S21 Pro ASIC chips</strong></p>' +
      '<p><em>✓</em> <strong>Lifetime warranty</strong></p>'
  };

  function swapBulletsToMiner(handle) {
    var copy = BULLETS_BY_MINER[handle];
    if (!copy) return;
    // The custom-richtext block (description "Take your shot at winning...")
    // and the icon-text block (the ✓ bullet list) BOTH render with the
    // same `.cs_icon-text-main` wrapper class. We only want to touch the
    // bullets, so filter to wraps whose content already contains a
    // checkmark glyph (✓) — the description has no checkmarks.
    //
    // Shopify renders the icon-text block twice on this template (via
    // `content_for 'block'` and `content_for 'blocks'`), so we update the
    // first matching wrap and hide the host sections of the rest.
    var allWraps = document.querySelectorAll('.cs_icon-text-main');
    var bulletWraps = [];
    for (var w = 0; w < allWraps.length; w++) {
      if ((allWraps[w].textContent || '').indexOf('✓') !== -1) {
        bulletWraps.push(allWraps[w]);
      }
    }
    if (!bulletWraps.length) {
      console.warn('[MB Mtype] No .cs_icon-text-main bullet wraps found');
      return;
    }
    bulletWraps[0].innerHTML = copy;
    for (var i = 1; i < bulletWraps.length; i++) {
      var hostSection = bulletWraps[i].closest('.icon-textt') || bulletWraps[i].parentElement;
      if (hostSection) hostSection.style.display = 'none';
    }
  }

  // Run the dedupe on page load too — without it the duplicate bullet
  // list is visible until the visitor clicks a miner pill.
  function initialBulletSwap() {
    var activePill = document.querySelector('.mb-mtype__pill.is-active');
    var handle = activePill && activePill.dataset.handle;
    swapBulletsToMiner(handle || 'pdp-v5');
  }

  // Shopify's slideshow component renders the gallery's media as a set
  // of <img class="product-media__image"> elements — typically duplicated
  // (one set for the main slide-area, another for the thumbnail strip).
  // To present each non-current miner's *full* gallery (so the visitor
  // can scroll thumbnails like on that miner's own product page), we
  // pre-fetched each product's `images` array into MINER_DATA and now
  // distribute those URLs across whatever gallery slots the page renders.
  //
  // The pdp-v5 gallery is the canonical layout — its slot count and
  // ordering. When a non-current miner is selected we cycle that miner's
  // images through those slots; when more slots than images, we wrap.
  var ORIGINAL_HERO_SRCS = null;   // array of original src strings, one per <img>

  function findAllHeroImages() {
    // Cast a wide net: every <img> inside the gallery component(s).
    // Shopify renders ~20 of them (5 main slides + 5 thumbnail-strip
    // images + lazy/duplicated variants). Swapping the .product-media__image
    // subset (only ~10) leaves the visible thumbnails stale, so we target
    // every img in the gallery host elements.
    return document.querySelectorAll('media-gallery img, slideshow-component img');
  }

  function captureOriginalHeroes() {
    if (ORIGINAL_HERO_SRCS !== null) return;
    var imgs = findAllHeroImages();
    if (!imgs.length) return;
    ORIGINAL_HERO_SRCS = [];
    imgs.forEach(function(img){
      ORIGINAL_HERO_SRCS.push(img.src || '');
      img.setAttribute('data-mb-original-src', img.src || '');
    });
  }

  function pickImagesForHandle(handle) {
    var data = window.MB_MINER_DATA || {};
    var entry = data[handle];
    if (!entry) return null;
    if (Array.isArray(entry.images) && entry.images.length) return entry.images;
    // Fallback: just the featured image as a single-element array
    var fi = entry.featuredImage;
    if (!fi) return null;
    if (typeof fi === 'string') return [fi];
    if (fi.src) {
      var src = fi.src;
      if (src.indexOf('//') === 0) src = 'https:' + src;
      return [src];
    }
    return null;
  }

  // Pair gallery <img> elements by index across slides + thumbnails so the
  // mainstage and the thumbnail strip stay in sync with each other.
  // Each "slot" gets one image from the active miner's array (cycling).
  function distributeImagesToGallery(images) {
    var imgs = findAllHeroImages();
    if (!imgs.length || !images || !images.length) return;
    imgs.forEach(function(img, i){
      img.src = images[i % images.length];
      img.removeAttribute('srcset');   // strip srcset so our src isn't overridden
    });
  }

  function swapHero(handle) {
    captureOriginalHeroes();
    var imgs = findAllHeroImages();
    if (!imgs.length) {
      console.warn('[MB Mtype] No gallery images found');
      return;
    }
    if (handle === 'pdp-v5') {
      // Restore the page's original Miner Forge PRO gallery slot-by-slot.
      imgs.forEach(function(img, i){
        var orig = img.getAttribute('data-mb-original-src');
        if (orig === null && ORIGINAL_HERO_SRCS && ORIGINAL_HERO_SRCS[i] !== undefined) {
          orig = ORIGINAL_HERO_SRCS[i];
        }
        if (orig) {
          img.src = orig;
          img.removeAttribute('srcset');
        }
      });
      return;
    }
    var images = pickImagesForHandle(handle);
    if (!images) {
      console.log('[MB Mtype] No images yet for', handle, '- waiting for hydration');
      return;
    }
    distributeImagesToGallery(images);
  }

  function openPopup() {
    var popup = document.querySelector('[data-mb-popup]');
    if (!popup) return;
    popup.removeAttribute('hidden');
    document.body.classList.add('mb-mtype-popup-open');
  }

  function closePopup() {
    var popup = document.querySelector('[data-mb-popup]');
    if (!popup) return;
    popup.setAttribute('hidden', '');
    document.body.classList.remove('mb-mtype-popup-open');
  }

  // Track which miner the user clicked, so when its data finishes
  // hydrating asynchronously we can apply the image even though the
  // change event already fired earlier.
  var PENDING_HANDLE = null;

  document.addEventListener('click', function (ev) {
    var pill = ev.target.closest('.mb-mtype__pill');
    if (pill) {
      var handle = pill.dataset.handle;
      if (!handle) return;
      var wrap = pill.closest('[data-mb-mtype]');
      if (wrap) {
        wrap.querySelectorAll('.mb-mtype__pill').forEach(function (p) {
          var isActive = p === pill;
          p.classList.toggle('is-active', isActive);
          p.setAttribute('aria-checked', isActive ? 'true' : 'false');
        });
      }
      PENDING_HANDLE = handle;
      // Tell the bundle (and anyone else) which miner is active now.
      document.dispatchEvent(new CustomEvent('mb:miner-changed', {
        detail: { handle: handle }
      }));
      // Also swap the hero image. If image not yet hydrated, the
      // 'mb:miner-hydrated' listener below will retry once it's ready.
      swapHero(handle);
      // And swap the bullet points so the spec list matches the miner.
      swapBulletsToMiner(handle);
      return;
    }

    if (ev.target.closest('[data-mb-open-popup]')) {
      openPopup();
      return;
    }

    if (ev.target.closest('[data-mb-popup-close]')) {
      closePopup();
      return;
    }
  });

  // When the bundle finishes fetching a non-current product's full image
  // array, populate the gallery if that miner is the one the user wants
  // to see. This handles the race where the user clicks Bitaxe / Titan
  // Max before the background fetch has resolved.
  document.addEventListener('mb:miner-images-hydrated', function (ev) {
    var handle = ev && ev.detail && ev.detail.handle;
    if (!handle) return;
    if (PENDING_HANDLE === handle) {
      swapHero(handle);
    }
  });

  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') {
      var popup = document.querySelector('[data-mb-popup]');
      if (popup && !popup.hasAttribute('hidden')) closePopup();
    }
  });

  // Capture the original hero srcs once the DOM is ready so we can restore
  // them when the user comes back to Miner Forge PRO. Also run the initial
  // bullets swap (dedupe + populate to active miner).
  function onDomReady() {
    captureOriginalHeroes();
    initialBulletSwap();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', onDomReady);
  } else {
    onDomReady();
  }
})();
</script>

{% schema %}
{
  "name": "Miner Type Selector V5",
  "settings": [],
  "presets": [{ "name": "Miner Type Selector V5" }]
}
{% endschema %}
