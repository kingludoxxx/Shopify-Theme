<style>
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background-color: {{ section.settings.back_color }};
  }
  .cs_ris-text-main p{
    margin: 0;
    color: #000000;
    line-height: 24px;
    font-size: 14px;
    font-family: Satoshi-Bold;
    font-weight: 400;
}
.cs_ris-text-main p strong{
    margin: 0;
    color: #000000;
    line-height: 24px;
    font-size: 14px;
    font-family: Satoshi-Bold;
    font-weight: 900;
}
.cs_ris-img img{
    display: block;
    object-fit: cover;
    width: 100%;
    height: auto;
    max-width: 62px;
    max-height: 62px;
    min-width: 62px;
    min-height: 62px;
}
.main-ris-text{
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px;
    justify-content: center;
    border: 1px solid #000;
    border-radius: 12px;
}
  @media screen and (max-width: 768px) {
      .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.mbl_padding_top }}px;
          padding-bottom: {{ section.settings.mbl_padding_bottom }}px;
      }
  }
</style>

<section class="section-{{ section.id }}-padding">
  <div class="main-ris-text">
    <div class="cs_ris-img">
        <img src="{{ block.settings.image | image_url }}" width="100%" height="auto"  loading="lazy">
    </div>
    <div class="cs_ris-text-main">{{ block.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "risk-free",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 10
    },
    {
      "type": "range",
      "id": "mbl_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "mbl_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 10
    },
    {
      "type": "color",
      "id": "back_color",
      "label": "Background Color"
    },
    {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
    },
    {
        "type": "richtext",
        "id": "text",
        "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "risk-free",
      "category": "Custom"
    }
  ]
}
{% endschema %}
