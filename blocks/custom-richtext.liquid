<style>
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background-color: {{ section.settings.back_color }};
  }
  .cs_icon-text-main p{
    display:flex;
    align-items:center;
    gap:10px;
    margin: 0;
    color: #1a1a1a;
    font-weight: 400;
    font-size: 18px !important;
    line-height: 1.5 !important;
    font-family: Satoshi-Bold;
    letter-spacing: 0px !important;
}
  @media screen and (max-width: 768px) {
      .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.mbl_padding_top }}px;
          padding-bottom: {{ section.settings.mbl_padding_bottom }}px;
      }
  }
</style>

<section class="icon-textt section-{{ section.id }}-padding">
  <div class="main-iconn-text">
    {% if block.settings['rich-text'] %}
    <div class="cs_icon-text-main">{{ block.settings.rich-text }}</div>
    {%  endif %}
  </div>
</section>

{% schema %}
{
  "name": "custom richtext",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 10
    },
    {
      "type": "range",
      "id": "mbl_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "mbl_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 10
    },
    {
      "type": "color",
      "id": "back_color",
      "label": "Background Color"
    },
    {
        "type": "richtext",
        "id": "rich-text",
        "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "custom richtext",
      "category": "Custom"
    }
  ]
}
{% endschema %}
