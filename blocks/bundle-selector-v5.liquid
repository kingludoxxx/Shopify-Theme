{%- comment -%}
  MineBlock Bundle Selector — V5 (split test for /products/pdp-v5)
  ----------------------------------------------------------------
  Vertical-stack card layout (matches the operator's preferred design,
  same look the existing pdp-v1/v2 templates use). Four tiers:

    Tier 1: Buy 1 Miner       — no inline badge, no corner badge
    Tier 2: Buy 2 Miners      — "2x ODDS" inline badge
    Tier 3: Buy 3, get 1 free — "4x ODDS" inline badge + "Best Value" corner badge (default-selected)
    Tier 6: Buy 6, get 2 free — "8x ODDS" inline badge + "Highest Chances" corner badge

  Each card shows: stack of N product images on the left, title +
  inline ODDS pill + savings text in the middle, current price +
  compare-at strikethrough on the right. Selected card gets a black
  border on a white background; non-selected sit on a subtle gray.

  All prices are pulled from MINER_DATA so when the visitor switches
  miner via the pill selector above, every tier's price + savings +
  product image updates in place.
{%- endcomment -%}

<div class="mbb" data-mbb>
  <div class="mbb__heading"><span>BUNDLE &amp; SAVE</span></div>
  <div class="mbb__rows" role="radiogroup" aria-label="Choose your bundle">

    <button type="button" class="mbb-row" data-tier="1" aria-checked="false">
      <span class="mbb-row__imgs">
        <img class="mbb-row__img" data-tier-img="1" src="" alt="Buy 1 Miner" loading="lazy" width="120" height="120">
      </span>
      <span class="mbb-row__main">
        <span class="mbb-row__title-line">
          <span class="mbb-row__title">Buy 1 Miner</span>
        </span>
        <span class="mbb-row__sub" data-tier-saved-wrap="1">You save <span data-tier-saved="1">$0.00</span></span>
      </span>
      <span class="mbb-row__price">
        <span class="mbb-row__price-current" data-tier-price="1">$0.00</span>
        <s class="mbb-row__price-compare" data-tier-compare="1">$0.00</s>
      </span>
    </button>

    <button type="button" class="mbb-row" data-tier="2" aria-checked="false">
      <span class="mbb-row__imgs">
        <img class="mbb-row__img" data-tier-img="2" src="" alt="Buy 2 Miners" loading="lazy" width="120" height="120">
      </span>
      <span class="mbb-row__main">
        <span class="mbb-row__title-line">
          <span class="mbb-row__title">Buy 2 Miners</span>
          <span class="mbb-row__odds">2x ODDS</span>
        </span>
        <span class="mbb-row__sub" data-tier-saved-wrap="2">You save <span data-tier-saved="2">$0.00</span></span>
      </span>
      <span class="mbb-row__price">
        <span class="mbb-row__price-current" data-tier-price="2">$0.00</span>
        <s class="mbb-row__price-compare" data-tier-compare="2">$0.00</s>
      </span>
    </button>

    <button type="button" class="mbb-row is-selected" data-tier="3" aria-checked="true">
      <span class="mbb-row__corner-badge">Best Value</span>
      <span class="mbb-row__imgs">
        <img class="mbb-row__img" data-tier-img="3" src="" alt="Buy 3, get 1 free" loading="lazy" width="120" height="120">
      </span>
      <span class="mbb-row__main">
        <span class="mbb-row__title-line">
          <span class="mbb-row__title">Buy 3, get 1 free</span>
          <span class="mbb-row__odds">4x ODDS</span>
        </span>
        <span class="mbb-row__sub" data-tier-saved-wrap="3">You save <span data-tier-saved="3">$0.00</span></span>
      </span>
      <span class="mbb-row__price">
        <span class="mbb-row__price-current" data-tier-price="3">$0.00</span>
        <s class="mbb-row__price-compare" data-tier-compare="3">$0.00</s>
      </span>
    </button>

    <button type="button" class="mbb-row" data-tier="6" aria-checked="false">
      <span class="mbb-row__corner-badge">Highest Chances</span>
      <span class="mbb-row__imgs">
        <img class="mbb-row__img" data-tier-img="6" src="" alt="Buy 6, get 2 free" loading="lazy" width="120" height="120">
      </span>
      <span class="mbb-row__main">
        <span class="mbb-row__title-line">
          <span class="mbb-row__title">Buy 6, get 2 free</span>
          <span class="mbb-row__odds">8x ODDS</span>
        </span>
        <span class="mbb-row__sub" data-tier-saved-wrap="6">You save <span data-tier-saved="6">$0.00</span></span>
      </span>
      <span class="mbb-row__price">
        <span class="mbb-row__price-current" data-tier-price="6">$0.00</span>
        <s class="mbb-row__price-compare" data-tier-compare="6">$0.00</s>
      </span>
    </button>

  </div>
</div>

<style>
  .mbb { font-family: 'Manrope', sans-serif; margin: 0; }

  .mbb__heading {
    text-align: center;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    margin: 8px 0 14px;
    color: #000;
  }
  .mbb__heading::before,
  .mbb__heading::after {
    content: '';
    display: inline-block;
    vertical-align: middle;
    width: 18%;
    height: 1px;
    background: rgba(0, 0, 0, 0.2);
  }
  .mbb__heading::before { margin-right: 14px; }
  .mbb__heading::after  { margin-left: 14px; }

  .mbb__rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mbb-row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: center;
    border: 2px solid #e3e3e3;
    border-radius: 12px;
    padding: 10px 16px 10px 8px;
    background: #f5f5f5;
    cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease;
    font-family: 'Manrope', sans-serif;
    width: 100%;
    text-align: left;
  }
  .mbb-row.is-selected {
    background: #fff;
    border-color: #000;
  }
  .mbb-row:hover:not(.is-selected) { border-color: #999; }
  .mbb-row:focus-visible { outline: 2px solid #1126a5; outline-offset: 2px; }

  /* Tier card image (single composite per tier — 1, 2, or 3 miners
     pre-rendered into one image, sourced from MINER_DATA[handle].bundleImages) */
  .mbb-row__imgs {
    position: relative;
    width: 84px;
    height: 64px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mbb-row__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Middle column */
  .mbb-row__main { min-width: 0; }
  .mbb-row__title-line {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .mbb-row__title {
    font-weight: 700;
    font-size: 16px;
    color: #000;
    line-height: 1.2;
    font-family: 'Manrope', sans-serif !important;
  }
  .mbb-row__odds {
    display: inline-block;
    background: #e9e9e9;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 700;
    color: #000;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .mbb-row__sub {
    display: block;
    color: #555;
    font-size: 13px;
    margin-top: 2px;
    font-weight: 500;
  }

  /* Right column (price) */
  .mbb-row__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
  }
  .mbb-row__price-current {
    font-weight: 700;
    font-size: 19px;
    color: #000;
    line-height: 1.1;
    white-space: nowrap;
  }
  .mbb-row__price-compare {
    color: #999;
    font-size: 13px;
    text-decoration-thickness: 2px;
    white-space: nowrap;
  }

  /* Corner badge (Best Value / Highest Chances) */
  .mbb-row__corner-badge {
    position: absolute;
    top: -11px;
    right: 18px;
    background: #1126a5;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 6px;
    white-space: nowrap;
    z-index: 5;
    letter-spacing: 0.01em;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .mbb__heading { font-size: 13px; margin: 4px 0 10px; letter-spacing: 0.04em; }
    .mbb__heading::before, .mbb__heading::after { width: 12%; }
    .mbb-row { padding: 8px 12px 8px 4px; gap: 8px; border-radius: 10px; }
    .mbb-row__imgs { width: 64px; height: 52px; }
    .mbb-row__img { width: 100%; height: 100%; }
    .mbb-row__title { font-size: 13px; }
    .mbb-row__odds { font-size: 10px; padding: 2px 8px; }
    .mbb-row__sub { font-size: 11px; margin-top: 2px; }
    .mbb-row__price-current { font-size: 15px; }
    .mbb-row__price-compare { font-size: 11px; }
    .mbb-row__corner-badge { font-size: 10px; padding: 3px 10px; right: 10px; top: -9px; }
  }

  /* Tighten gap between bundle and Add to Cart on pdp-v5 */
  body.template-product-pdp-v5 .buy-buttons-block { display: block; margin-top: 6px !important; }
  body.template-product-pdp-v5 .product-form-buttons { margin-top: 0 !important; }
</style>

<script>
(function(){
  if (window.__MB_BUNDLE_V5_V1__) return;
  window.__MB_BUNDLE_V5_V1__ = true;

  var WRAP = document.querySelector('[data-mbb]');
  if (!WRAP) {
    console.warn('[MB Bundle] wrapper [data-mbb] not found');
    return;
  }

  // === HELPERS ===
  function onReady(fn){
    if (document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', fn);
    } else {
      fn();
    }
  }

  // Use Shopify's money format so this works with Markets / currencies
  var MONEY_FORMAT = {{ shop.money_format | json }};

  function formatMoney(cents){
    try {
      if (window.Shopify && typeof Shopify.formatMoney === 'function'){
        return Shopify.formatMoney(cents, MONEY_FORMAT);
      }
    } catch(e){}
    var v = (cents / 100).toFixed(2);
    return '$' + v;
  }

  // === MULTI-MINER DATA (V5 split test) ============================
  //
  // Three independent Shopify products are reachable from this page via
  // the Miner-type selector pills (rendered by blocks/miner-type-selector-v5.liquid):
  //
  //   - 'pdp-v5'        Miner Forge PRO 2.0 (the page's primary product)
  //   - 'bitaxe-gamma'  Bitaxe Gamma Miner
  //   - 'titan-max'     Titan Max
  //
  // Strategy:
  //   - The CURRENT product is rendered via Liquid (`closest.product`).
  //   - The OTHER two products' variant IDs, prices, and featured image
  //     URLs are HARDCODED — values were pulled directly from the live
  //     /products/<handle>.js endpoints. Hardcoding eliminates every
  //     async failure mode (CORS / preview restrictions / fetch errors)
  //     that produced $0.00 prices in earlier versions.
  //   - If the operator changes prices in Shopify Admin, this file must
  //     be updated to reflect them (or the v5 split test re-tooled to
  //     fetch). For a short-lived split test, hardcoding is the right
  //     trade-off — pure reliability.
  //
  // Variant ordering convention:
  //   variants[0] = tier 1 (single)
  //   variants[1] = tier 2
  //   variants[2] = tier 3 (3 + 1 free)
  //   variants[3] = tier 6 (6 + 2 free)   ← only pdp-v5 has this
  {% assign mb_self = closest.product %}
  // bundleImages: per-tier composite image (1, 2, 3 miners stacked) used
  // ONLY in the bundle cards — separate from `featuredImage` which is the
  // page hero. URLs are the same composites already used by
  // /products/pdp-v1 (Kaching-Bundles-*), /products/bitaxe-gamma
  // (1_/2_/3_*), and /products/titan-max (Bundle_Images_*).
  // Tier 6 has no dedicated composite for any miner, so it falls back
  // to the tier-3 image (3 stacked miners).
  var MINER_DATA = {
    'pdp-v5': {
      handle: 'pdp-v5',
      label: 'Miner Forge PRO',
      featuredImage: {{ mb_self.featured_image | image_url: width: 1080 | json }},
      bundleImages: {
        1: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Kaching-Bundles-1.png?v=1765567011',
        2: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Kaching-Bundles-2.png?v=1765567044',
        3: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Kaching-Bundles-3.png?v=1765567063',
        6: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Kaching-Bundles-3.png?v=1765567063'
      },
      variantIds: {
        1: {{ mb_self.variants[0].id | default: 0 | json }},
        2: {{ mb_self.variants[1].id | default: mb_self.variants[0].id | json }},
        3: {{ mb_self.variants[2].id | default: mb_self.variants[1].id | json }},
        6: {{ mb_self.variants[3].id | default: mb_self.variants[2].id | json }}
      },
      prices: {
        1: { price: {{ mb_self.variants[0].price                | default: 0 | json }}, compare_at: {{ mb_self.variants[0].compare_at_price                | default: 0 | json }} },
        2: { price: {{ mb_self.variants[1].price                | default: 0 | json }}, compare_at: {{ mb_self.variants[1].compare_at_price                | default: 0 | json }} },
        3: { price: {{ mb_self.variants[2].price                | default: 0 | json }}, compare_at: {{ mb_self.variants[2].compare_at_price                | default: 0 | json }} },
        6: { price: {{ mb_self.variants[3].price | default: mb_self.variants[2].price | default: 0 | json }}, compare_at: {{ mb_self.variants[3].compare_at_price | default: mb_self.variants[2].compare_at_price | default: 0 | json }} }
      }
    },
    'bitaxe-gamma': {
      handle: 'bitaxe-gamma',
      label: 'Bitaxe Gamma Shot',
      featuredImage: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Image_1.webp?v=1775669027',
      bundleImages: {
        1: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/1_400d2077-668a-4da5-ad3e-f4c8d3f2843b.png?v=1773610453',
        2: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/2_f9b6aba0-a13a-4732-b230-3c270b07a5c5.png?v=1773610455',
        3: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/3_6312b2c4-4d1a-42a9-ad49-9fba54474a0c.png?v=1773610457',
        6: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/3_6312b2c4-4d1a-42a9-ad49-9fba54474a0c.png?v=1773610457'
      },
      variantIds: {
        1: 56317844947275,
        2: 56317844980043,
        3: 56317845012811,
        6: 56317845012811   /* fallback: tier 3 (no Buy 6 variant exists for bitaxe-gamma) */
      },
      prices: {
        1: { price: 29999, compare_at: 49998 },
        2: { price: 59998, compare_at: 99996 },
        3: { price: 89997, compare_at: 199992 },
        6: { price: 89997, compare_at: 199992 }   /* fallback: tier 3 */
      }
    },
    'titan-max': {
      handle: 'titan-max',
      label: 'Titan Max',
      featuredImage: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Image_2.webp?v=1775669054',
      bundleImages: {
        1: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Bundle_Images_1.png?v=1773610130',
        2: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Bundle_Images_2.png?v=1773610130',
        3: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Bundle_Images_3.png?v=1773610130',
        6: 'https://cdn.shopify.com/s/files/1/0768/4787/4379/files/Bundle_Images_3.png?v=1773610130'
      },
      variantIds: {
        1: 56317845307723,
        2: 56317845340491,
        3: 56317845373259,
        6: 56317845373259   /* fallback: tier 3 (no Buy 6 variant exists for titan-max) */
      },
      prices: {
        1: { price: 150000, compare_at: 270000 },
        2: { price: 300000, compare_at: 540000 },
        3: { price: 450000, compare_at: 1080000 },
        6: { price: 450000, compare_at: 1080000 }   /* fallback: tier 3 */
      }
    }
  };

  // Bake in pdp-v5's full media list (for the gallery image-swap feature).
  // The other two miners' image arrays are hydrated asynchronously from
  // /products/HANDLE.js below.
  MINER_DATA['pdp-v5'].images = [
    {%- for media in mb_self.media -%}
      {%- if media.preview_image -%}
        {{ media.preview_image | image_url: width: 1500 | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- elsif media.src -%}
        {{ media.src | image_url: width: 1500 | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ];

  // Hydrate full image arrays for the two non-current miners so the
  // miner-type selector can populate the entire media gallery (slides
  // + thumbnails) when the user switches miner — not just the featured
  // image. Fetched once on page load and cached on MINER_DATA.
  ['bitaxe-gamma', 'titan-max'].forEach(function(handle){
    fetch('/products/' + handle + '.js', { credentials: 'same-origin' })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(p){
        if (!p) return;
        var imgs = (p.images || []).map(function(s){
          return (typeof s === 'string' && s.indexOf('//') === 0) ? 'https:' + s : s;
        });
        MINER_DATA[handle].images = imgs;
        console.log('[MB Bundle] Hydrated', imgs.length, 'images for', handle);
        document.dispatchEvent(new CustomEvent('mb:miner-images-hydrated', {
          detail: { handle: handle, images: imgs }
        }));
      })
      .catch(function(err){ console.warn('[MB Bundle] image hydrate failed for', handle, err); });
  });

  // Expose the data store on window so the miner-type selector can read
  // featured images / image arrays without its own data layer.
  window.MB_MINER_DATA = MINER_DATA;

  // Active miner on first render. The page's primary product is Miner
  // Forge PRO 2.0 (the v5 product itself), so the Miner Forge PRO pill
  // is pre-selected by default. Mutated by the 'mb:miner-changed' event
  // from the miner-type selector when the visitor clicks another pill.
  var ACTIVE_MINER = 'pdp-v5';

  // Direct references — re-pointed in the event handler when miner changes.
  var VARIANTS_BY_TIER = MINER_DATA[ACTIVE_MINER].variantIds;
  var PRICE_BY_TIER    = MINER_DATA[ACTIVE_MINER].prices;

  console.log('[MB Bundle] Initialized with miner data', MINER_DATA);

  // === TIERS CONFIG (non-price data only) ===
  // Gifts removed in V5; setSelected() doesn't depend on these fields anymore.
  var TIERS = {
    1: { paidMiners: 1, freeMiners: 0 },
    2: { paidMiners: 2, freeMiners: 0 },
    3: { paidMiners: 3, freeMiners: 1 },
    6: { paidMiners: 6, freeMiners: 2 }
  };

  function getMbbWrap(){
    if (WRAP && WRAP.isConnected) return WRAP;
    WRAP = document.querySelector('[data-mbb]');
    return WRAP;
  }

  /**
   * Always resolve the live product form + inputs. The theme morphs the form after
   * cart updates; stale references would update detached nodes so the next ATC
   * submits the wrong variant or omits bundle rig line items.
   */
  function syncFormFields(optWrap){
    var wrap = optWrap || getMbbWrap();
    if (!wrap || !wrap.isConnected) return;

    var section = wrap.closest('.shopify-section') || wrap.closest('section') || document;
    var productForm =
      section.querySelector('product-form form') ||
      section.querySelector('form[action^="/cart/add"]');

    if (!productForm){
      console.warn('[MB Bundle] Product form not found near bundle.');
      return;
    }

    var variantIdInput =
      productForm.querySelector('input[name="id"][ref="variantId"]') ||
      productForm.querySelector('input[name="id"]');

    if (!variantIdInput){
      console.warn('[MB Bundle] Variant ID input not found.');
    }

    var tier   = +wrap.dataset.tier || 2;
    var mainVariantId = VARIANTS_BY_TIER[tier] || VARIANTS_BY_TIER[2];

    if (variantIdInput){
      variantIdInput.value = String(mainVariantId);
    }

    console.log('[MB Bundle] Synced form fields for tier', tier, 'mainVariantId', mainVariantId);
  }

  // Re-sync immediately before the theme builds FormData (morph-safe).
  if (!window.__MB_BUNDLE_SUBMIT_SYNC__) {
    window.__MB_BUNDLE_SUBMIT_SYNC__ = true;
    document.addEventListener(
      'submit',
      function (ev) {
        var form = ev.target;
        if (!(form instanceof HTMLFormElement)) return;
        var action = form.getAttribute('action') || '';
        if (action.indexOf('cart/add') === -1) return;

        var formSection = form.closest('.shopify-section');
        if (!formSection) return;
        var wrap = formSection.querySelector('[data-mbb]');
        if (!wrap) return;

        syncFormFields(wrap);
      },
      true
    );
  }

  // === RENDER PER-TIER PRICES + IMAGES ===
  // Re-runs whenever the active miner changes. Iterates all 4 tiers and
  // updates each card's price, compare-at strike, "You save $X" text,
  // and the stack of product images. Hides "You save" entirely when the
  // active miner has no compare-at on that tier (e.g., Miner Forge PRO's
  // single-unit variant has no discount).
  function renderAllTiers(){
    var wrap = getMbbWrap();
    if (!wrap) return;
    var data = MINER_DATA[ACTIVE_MINER];
    if (!data) return;
    var prices       = data.prices || {};
    var bundleImages = data.bundleImages || {};

    // Fallback hero image if a tier doesn't have a dedicated composite.
    var fallbackHero = '';
    if (Array.isArray(data.images) && data.images.length) {
      fallbackHero = data.images[0];
    } else {
      fallbackHero = data.featuredImage || '';
    }
    if (fallbackHero && typeof fallbackHero !== 'string' && fallbackHero.src) fallbackHero = fallbackHero.src;
    if (typeof fallbackHero === 'string' && fallbackHero.indexOf('//') === 0) fallbackHero = 'https:' + fallbackHero;

    [1, 2, 3, 6].forEach(function(tier){
      var p = prices[tier] || { price: 0, compare_at: 0 };
      var priceCents   = p.price || 0;
      var compareCents = p.compare_at || 0;
      var savedCents   = compareCents - priceCents;

      var priceEl     = wrap.querySelector('[data-tier-price="' + tier + '"]');
      var compareEl   = wrap.querySelector('[data-tier-compare="' + tier + '"]');
      var savedEl     = wrap.querySelector('[data-tier-saved="' + tier + '"]');
      var savedWrapEl = wrap.querySelector('[data-tier-saved-wrap="' + tier + '"]');

      if (priceEl)   priceEl.textContent = formatMoney(priceCents);
      if (compareEl) {
        if (compareCents > priceCents) {
          compareEl.style.display = '';
          compareEl.textContent = formatMoney(compareCents);
        } else {
          compareEl.style.display = 'none';
        }
      }
      if (savedEl && savedWrapEl) {
        if (savedCents > 0) {
          savedWrapEl.style.display = '';
          savedEl.textContent = formatMoney(savedCents);
        } else {
          savedWrapEl.style.display = 'none';
        }
      }

      // Tier-specific composite image (1, 2, or 3 miners stacked into one
      // pre-rendered PNG). Falls back to the active miner's general hero
      // image if no composite is mapped for this tier.
      var imgSrc = bundleImages[tier] || fallbackHero;
      var imgEl = wrap.querySelector('[data-tier-img="' + tier + '"]');
      if (imgEl && imgSrc) imgEl.src = imgSrc;
    });

    // Hide the Buy 6 (tier 6) card for miners that don't have a real
    // Buy 6 + 2 free variant. Bitaxe Gamma Shot and Titan Max each only
    // have 3 variants (Buy 1 / Buy 2 / Buy 3+1) in Shopify, so showing
    // Buy 6 would just fall back to tier-3 prices and confuse the visitor.
    var tier6Row = wrap.querySelector('.mbb-row[data-tier="6"]');
    if (tier6Row) {
      tier6Row.style.display = (ACTIVE_MINER === 'pdp-v5') ? '' : 'none';
    }
  }

  // === TIER SELECTION ===
  // Visual highlight + form variant ID sync. Doesn't touch prices; those
  // live inside each tier card and are managed by renderAllTiers().
  function setSelected(tier){
    var wrap = getMbbWrap();
    if (!wrap) return;
    var rows = wrap.querySelectorAll('.mbb-row');
    rows.forEach(function(r){
      var is = (+r.getAttribute('data-tier') === +tier);
      r.classList.toggle('is-selected', is);
      r.setAttribute('aria-checked', is ? 'true' : 'false');
    });
    wrap.dataset.tier = String(tier);
    syncFormFields(wrap);
  }

  // Initial render. Default ACTIVE_MINER is Miner Forge PRO; default
  // bundle tier is 2 (Buy 2 Miners) — the v5 page's intended landing
  // selection. Other miners default to tier 1 (Buy 1) when switched in,
  // matching their standalone product pages.
  renderAllTiers();
  var initialTier = (ACTIVE_MINER === 'pdp-v5') ? 2 : 1;
  setSelected(initialTier);

  // Delegated click handler — survives section morphs that replace
  // .mbb-row nodes after cart updates.
  WRAP.addEventListener('click', function (ev) {
    var row = ev.target.closest('.mbb-row');
    if (!row || !ev.currentTarget.contains(row)) return;
    setSelected(+row.getAttribute('data-tier'));
  });

  // React to the Miner Type Selector switching active product.
  // Repoints data references, re-renders all tier cards (prices + images),
  // and resets the highlighted tier:
  //   - pdp-v5 (Miner Forge PRO)  → tier 3 (Best Value, the v5 default)
  //   - bitaxe-gamma / titan-max  → tier 1 (matches each miner's standalone
  //     product page, where Buy 1 is the default-shown price)
  document.addEventListener('mb:miner-changed', function (ev) {
    var handle = ev && ev.detail && ev.detail.handle;
    if (!handle || !MINER_DATA[handle]) {
      console.warn('[MB Bundle] Unknown miner handle:', handle);
      return;
    }
    if (handle === ACTIVE_MINER) return;
    ACTIVE_MINER = handle;
    VARIANTS_BY_TIER = MINER_DATA[handle].variantIds;
    PRICE_BY_TIER    = MINER_DATA[handle].prices;

    renderAllTiers();
    var resetTier = (handle === 'pdp-v5') ? 3 : 1;
    setSelected(resetTier);
    console.log('[MB Bundle] Switched to miner:', handle, 'reset to tier', resetTier, 'variantId', VARIANTS_BY_TIER[resetTier], 'price', PRICE_BY_TIER[resetTier]);
  });

  // Once the other miners' image arrays come back from /products/HANDLE.js,
  // re-render so their tier cards get populated images even if the user
  // never clicks a different miner pill.
  document.addEventListener('mb:miner-images-hydrated', function () {
    if (ACTIVE_MINER !== 'pdp-v5') renderAllTiers();
  });

  onReady(function(){
    syncFormFields();
  });

})();
</script>


