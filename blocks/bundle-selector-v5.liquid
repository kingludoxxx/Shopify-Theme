{%- comment -%}
  MineBlock Bundle Selector — V5 (split test for /products/pdp-v5)
  Forked from blocks/bundle-selector.liquid on 2026-04-29.
  Differences vs original:
    - Bundle reduced to 4 tiers (1, 2, 3, 6); tiers 12 & 18 removed.
    - HIGHEST CHANCES badge moved from tier 18 onto tier 6.
    - "Included with your order" gifts section removed entirely.
    - JS dataset and price tables trimmed to match.
  Do NOT edit blocks/bundle-selector.liquid expecting these changes
  to take effect on pdp-v5; this file is the source of truth for v5.
{%- endcomment -%}

<div class="mbb" data-mbb>
  <!-- Tier cards -->
  <div class="mbb__grid" role="radiogroup" aria-label="Choose your bundle">
    <button type="button" class="mbb-card" data-tier="1" aria-checked="false">
      <span class="mbb-badge is-empty"></span>
      <span class="mbb-title">Buy 1 Miner</span>
      <span class="mbb-sub">&nbsp;</span>
    </button>

    <button type="button" class="mbb-card is-pop is-selected" data-tier="2" aria-checked="true">
      <span class="mbb-badge is-empty"></span>
      <span class="mbb-title">Buy 2 Miners</span>
      <span class="mbb-sub">Save 21%</span>
    </button>

    <button type="button" class="mbb-card is-best" data-tier="3" aria-checked="false">
      <span class="mbb-badge" id="mbb-badge-best">BEST SELLER</span>
      <span class="mbb-title">Buy 3, get 1 free</span>
      <span class="mbb-sub">Save 36%</span>
    </button>

    <button type="button" class="mbb-card is-high" data-tier="6" aria-checked="false">
      <span class="mbb-badge">HIGHEST CHANCES</span>
      <span class="mbb-title">Buy 6, get 2 free</span>
      <span class="mbb-sub">Save 43%</span>
    </button>
  </div>

  <!-- Banner above ATC -->
  <div class="mbb-pricebar" data-mbb-pricebar>
  <div class="mbb-pricebar__left">
    <span class="mbb-compare" data-mbb-compare><s>$0.00</s></span>
    <span class="mbb-total" data-mbb-total>$0.00</span>
  </div>
  <div class="mbb-pricebar__right">
    <span class="mbb-save" data-mbb-save>You’re saving $0.00</span>
  </div>
</div>


</div>

<style>
  /* container spacing */
  .mbb{margin:0px;font-family: 'Manrope' ;}

  /* grid */
  .mbb__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  @media(min-width:900px){.mbb__grid{grid-template-columns:repeat(3,minmax(0,1fr));}}

  /* cards */
  .mbb-card{
    border:2px solid #e1e1e1;border-radius:14px;padding:16px 14px;background:#fff;
    text-align:center;cursor:pointer;position:relative;transition:all .18s ease;
  }
  .mbb-card.is-selected{
    border-color:#111;background:rgba(237,237,237,1);
  }

  .mbb-title{
    display:block;font-weight:700;font-size:14px;margin-top:8px;overflow:hidden;font-family: 'Manrope' !important; color: #000 !important;
  }
  .mbb-sub{
    display:block;color:#2b2b2b;margin-top:4px;font-size:13px;
    overflow:hidden;font-family: 'Manrope' !important; font-weight: 500;
  }

  .mbb-badge{
    position:absolute;top:-12px;left:50%;transform:translateX(-50%);
    background:#1126a5;color:#fff;font-size:11px;padding:4px 8px;border-radius:6px;
   
  }
  #mbb-badge-best {
    background:rgb(255, 255, 255);color:#000;border:2px solid rgb(125, 125, 125);
  }
  .mbb-badge.is-empty{background:transparent;color:transparent}

  /* gifts */
  .mbb-gifts{margin-top:18px}
  .mbb-gifts__title{text-align:center;font-weight:700;letter-spacing:.03em;font-size:14px}
  .mbb-gifts__grid{margin-top:12px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .mbb-gift{
    border:2px dashed #b9d9e6;border-radius:14px;padding:10px 8px;text-align:center;
    position:relative;background:#fff;
  }
  .mbb-pill{
    position:absolute;top:-10px;left:50%;transform:translateX(-50%);
    background:#f7eaa0;border-radius:999px;padding:3px 10px;font-size:11px;font-weight:700;
    white-space:nowrap; box-shadow: 0 2px 8px rgba(0,0,0,.08);
  border: 1px solid rgba(0,0,0,.06); color:#111;
  }
  /* make the strike price subtle + clean */
  .mbb-pill s{
    opacity: .85;
    text-decoration-thickness: 2px;
    text-decoration-color: rgba(0,0,0,.35);
  }

  .mbb-gift__img{height:74px;border-radius:10px;background:#fff;overflow:hidden;display:flex}
  .mbb-gift__img img{width:100%;height:100%;object-fit:contain;display:block}

  .mbb-gift__lbl{
    margin-top:8px;font-weight:700;font-size:12px;overflow:hidden;
  }

  .mbb-lock{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-size:22px;background:rgba(0,0,0,.55);color:#fff;border-radius:12px;
    opacity:0;pointer-events:none;
  }
  .mbb-gift.is-locked .mbb-lock{opacity:1}

/* 1) Parent: only mark as locked, no opacity here */
.mbb-gift.is-locked{
  filter:none;          /* no grayscale on whole box */
  opacity:1;            /* keep full opacity */
   border-color: #d0d0d0;
  background:#f7f7f7;
}

/* 2) Dim image + label only (NOT the pill) */
.mbb-gift.is-locked .mbb-gift__img,
.mbb-gift.is-locked .mbb-gift__lbl{
  filter:grayscale(1);
  opacity:.55;
}

/* 3) Pill stays colorful */
.mbb-gift.is-locked .mbb-pill{
  filter:none;
  opacity:1;
  z-index: 8;
}


    /* banner */

  .mbb-pricebar{
    margin-top:14px;
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:10px 0;
    border-top:1px solid #e8e8e8;
  }

  .mbb-pricebar__left{
    display:flex;
    align-items:baseline;
    gap:10px;
    min-width:0;
  }

  /* compare price: red + strike */
  .mbb-compare{
    color: #1225A5;
    font-weight:700;
    font-size:14px;
    white-space:nowrap;
  }
  .mbb-compare s{
    text-decoration-thickness:2px;
  }

  /* total: bold black */
  .mbb-total{
    color:#000;
    font-weight:700;
    font-size:16px;
    white-space:nowrap;
  }

  /* savings: right aligned */
  .mbb-save{
    color:#000;
    font-weight:600;
    font-size:14px;
    white-space:nowrap;
    text-align:right;
  }
@media (max-width: 450px) {
  .mbb-card{
    padding:10px 10px 13px;
    
  }
  
  .mbb-gifts__grid {
    gap: 4px !important;
  }
  .mbb-pill{
  padding:1px 8px;font-size:9px;
  }
  .mbb-gift__lbl{
   font-size:11px;
   margin: 0px;
  }
  .mbb-badge{
    
    font-size:9px;padding:3px 5px;
  }


}
  /* our bundle CTA */
.mbb-cta-wrap{
  margin-top:0px;
}

.mbb-cta{
  width:100%;
  border:none;
  border-radius:999px;
  padding:16px 24px;
  background:#1225A5;
  color:#fff;
  font-weight:700;
  font-size:16px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  cursor:pointer;
  transition:background .15s ease, transform .1s ease, box-shadow .15s ease;
}

.mbb-cta-icon{
  display:inline-flex;
  width:20px;
  height:20px;
}

.mbb-cta-icon svg{
  width:100%;
  height:100%;
  stroke-width:1.7;
}

.mbb-cta:hover{
  background:#0a177c;
  transform:translateY(-1px);
  box-shadow:0 10px 20px rgba(0,0,0,.16);
}

.mbb-cta:active{
  transform:translateY(0);
  box-shadow:none;
}
/* Tighten space between bundle pricebar and Add to Cart on pdp-v5 */
body.template-product-pdp-v5 .buy-buttons-block {
  display: block;            /* make sure span behaves like a block */
  margin-top: -18px !important; /* tweak value: 0–8px depending on taste */
}

/* Make sure the inner button group doesn't add extra gap */
body.template-product-pdp-v5 .product-form-buttons {
  margin-top: 0 !important;
}

/* Make HIGHEST CHANCES card visually distinct (matches former tier-18 emphasis) */
body.template-product-pdp-v5 .mbb-card.is-high {
  border-color: #1126a5;
}
</style>

<script>
(function(){
  if (window.__MB_BUNDLE_V5_V1__) return;
  window.__MB_BUNDLE_V5_V1__ = true;

  var WRAP = document.querySelector('[data-mbb]');
  if (!WRAP) {
    console.warn('[MB Bundle] wrapper [data-mbb] not found');
    return;
  }

  // === HELPERS ===
  function onReady(fn){
    if (document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', fn);
    } else {
      fn();
    }
  }

  // Use Shopify's money format so this works with Markets / currencies
  var MONEY_FORMAT = {{ shop.money_format | json }};

  function formatMoney(cents){
    try {
      if (window.Shopify && typeof Shopify.formatMoney === 'function'){
        return Shopify.formatMoney(cents, MONEY_FORMAT);
      }
    } catch(e){}
    var v = (cents / 100).toFixed(2);
    return '$' + v;
  }

  // === MULTI-MINER DATA (V5 split test) ============================
  //
  // Three independent Shopify products are reachable from this page via
  // the Miner-type selector pills (rendered by blocks/miner-type-selector-v5.liquid):
  //
  //   - 'pdp-v5'        Miner Forge PRO 2.0 (the page's primary product)
  //   - 'bitaxe-gamma'  Bitaxe Gamma Miner
  //   - 'titan-max'     Titan Max
  //
  // Each gets its variant IDs and per-tier prices baked in at render time
  // so the swap is instant and doesn't need a runtime fetch. Missing higher
  // tiers fall back to the closest lower tier so the bundle UI always works
  // even if a product is missing the "Buy 6 get 2 free" variant.
  //
  // Variant ordering convention (operator must keep this in Shopify Admin):
  //   variants[0] = tier 1 (single)
  //   variants[1] = tier 2
  //   variants[2] = tier 3 (3 + 1 free)
  //   variants[3] = tier 6 (6 + 2 free)   ← optional; falls back to [2] if absent
  //
  {%- assign mb_v5 = all_products['pdp-v5'] -%}
  {%- assign mb_bx = all_products['bitaxe-gamma'] -%}
  {%- assign mb_tm = all_products['titan-max'] -%}

  var MINER_DATA = {
    'pdp-v5': {
      handle: 'pdp-v5',
      label: 'Miner Forge PRO',
      variantIds: {
        1: {{ mb_v5.variants[0].id | default: 0 | json }},
        2: {{ mb_v5.variants[1].id | default: mb_v5.variants[0].id | json }},
        3: {{ mb_v5.variants[2].id | default: mb_v5.variants[1].id | json }},
        6: {{ mb_v5.variants[3].id | default: mb_v5.variants[2].id | json }}
      },
      prices: {
        1: { price: {{ mb_v5.variants[0].price                | default: 0 | json }}, compare_at: {{ mb_v5.variants[0].compare_at_price                | default: 0 | json }} },
        2: { price: {{ mb_v5.variants[1].price                | default: 0 | json }}, compare_at: {{ mb_v5.variants[1].compare_at_price                | default: 0 | json }} },
        3: { price: {{ mb_v5.variants[2].price                | default: 0 | json }}, compare_at: {{ mb_v5.variants[2].compare_at_price                | default: 0 | json }} },
        6: { price: {{ mb_v5.variants[3].price | default: mb_v5.variants[2].price | default: 0 | json }}, compare_at: {{ mb_v5.variants[3].compare_at_price | default: mb_v5.variants[2].compare_at_price | default: 0 | json }} }
      }
    },
    'bitaxe-gamma': {
      handle: 'bitaxe-gamma',
      label: 'Bitaxe Gamma Shot',
      variantIds: {
        1: {{ mb_bx.variants[0].id | default: 0 | json }},
        2: {{ mb_bx.variants[1].id | default: mb_bx.variants[0].id | json }},
        3: {{ mb_bx.variants[2].id | default: mb_bx.variants[1].id | json }},
        6: {{ mb_bx.variants[3].id | default: mb_bx.variants[2].id | default: mb_bx.variants[1].id | json }}
      },
      prices: {
        1: { price: {{ mb_bx.variants[0].price                | default: 0 | json }}, compare_at: {{ mb_bx.variants[0].compare_at_price                | default: 0 | json }} },
        2: { price: {{ mb_bx.variants[1].price                | default: 0 | json }}, compare_at: {{ mb_bx.variants[1].compare_at_price                | default: 0 | json }} },
        3: { price: {{ mb_bx.variants[2].price                | default: 0 | json }}, compare_at: {{ mb_bx.variants[2].compare_at_price                | default: 0 | json }} },
        6: { price: {{ mb_bx.variants[3].price | default: mb_bx.variants[2].price | default: 0 | json }}, compare_at: {{ mb_bx.variants[3].compare_at_price | default: mb_bx.variants[2].compare_at_price | default: 0 | json }} }
      }
    },
    'titan-max': {
      handle: 'titan-max',
      label: 'Titan Max',
      variantIds: {
        1: {{ mb_tm.variants[0].id | default: 0 | json }},
        2: {{ mb_tm.variants[1].id | default: mb_tm.variants[0].id | json }},
        3: {{ mb_tm.variants[2].id | default: mb_tm.variants[1].id | json }},
        6: {{ mb_tm.variants[3].id | default: mb_tm.variants[2].id | default: mb_tm.variants[1].id | json }}
      },
      prices: {
        1: { price: {{ mb_tm.variants[0].price                | default: 0 | json }}, compare_at: {{ mb_tm.variants[0].compare_at_price                | default: 0 | json }} },
        2: { price: {{ mb_tm.variants[1].price                | default: 0 | json }}, compare_at: {{ mb_tm.variants[1].compare_at_price                | default: 0 | json }} },
        3: { price: {{ mb_tm.variants[2].price                | default: 0 | json }}, compare_at: {{ mb_tm.variants[2].compare_at_price                | default: 0 | json }} },
        6: { price: {{ mb_tm.variants[3].price | default: mb_tm.variants[2].price | default: 0 | json }}, compare_at: {{ mb_tm.variants[3].compare_at_price | default: mb_tm.variants[2].compare_at_price | default: 0 | json }} }
      }
    }
  };

  // Active miner — defaults to the page's primary product.
  // Mutated by the 'mb:miner-changed' event (dispatched from the miner-type selector block).
  var ACTIVE_MINER = 'pdp-v5';

  function currentVariants() { return MINER_DATA[ACTIVE_MINER].variantIds; }
  function currentPrices()   { return MINER_DATA[ACTIVE_MINER].prices; }

  // Backwards-compat shims so the existing setSelected() / syncFormFields() code
  // keeps working without rewriting every reference.
  Object.defineProperty(window, '__MB_V5_BUNDLE_PROXY_INSTALLED__', { value: true, writable: false });
  var VARIANTS_BY_TIER = new Proxy({}, { get: function(_, k){ return currentVariants()[k]; } });
  var PRICE_BY_TIER    = new Proxy({}, { get: function(_, k){ return currentPrices()[k]; } });

  // === TIERS CONFIG (non-price data only) ===
  // Gifts removed in V5; setSelected() doesn't depend on these fields anymore.
  var TIERS = {
    1: { paidMiners: 1, freeMiners: 0 },
    2: { paidMiners: 2, freeMiners: 0 },
    3: { paidMiners: 3, freeMiners: 1 },
    6: { paidMiners: 6, freeMiners: 2 }
  };

  function getMbbWrap(){
    if (WRAP && WRAP.isConnected) return WRAP;
    WRAP = document.querySelector('[data-mbb]');
    return WRAP;
  }

  /**
   * Always resolve the live product form + inputs. The theme morphs the form after
   * cart updates; stale references would update detached nodes so the next ATC
   * submits the wrong variant or omits bundle rig line items.
   */
  function syncFormFields(optWrap){
    var wrap = optWrap || getMbbWrap();
    if (!wrap || !wrap.isConnected) return;

    var section = wrap.closest('.shopify-section') || wrap.closest('section') || document;
    var productForm =
      section.querySelector('product-form form') ||
      section.querySelector('form[action^="/cart/add"]');

    if (!productForm){
      console.warn('[MB Bundle] Product form not found near bundle.');
      return;
    }

    var variantIdInput =
      productForm.querySelector('input[name="id"][ref="variantId"]') ||
      productForm.querySelector('input[name="id"]');

    if (!variantIdInput){
      console.warn('[MB Bundle] Variant ID input not found.');
    }

    var tier   = +wrap.dataset.tier || 2;
    var mainVariantId = VARIANTS_BY_TIER[tier] || VARIANTS_BY_TIER[2];

    if (variantIdInput){
      variantIdInput.value = String(mainVariantId);
    }

    console.log('[MB Bundle] Synced form fields for tier', tier, 'mainVariantId', mainVariantId);
  }

  // Re-sync immediately before the theme builds FormData (morph-safe).
  if (!window.__MB_BUNDLE_SUBMIT_SYNC__) {
    window.__MB_BUNDLE_SUBMIT_SYNC__ = true;
    document.addEventListener(
      'submit',
      function (ev) {
        var form = ev.target;
        if (!(form instanceof HTMLFormElement)) return;
        var action = form.getAttribute('action') || '';
        if (action.indexOf('cart/add') === -1) return;

        var formSection = form.closest('.shopify-section');
        if (!formSection) return;
        var wrap = formSection.querySelector('[data-mbb]');
        if (!wrap) return;

        syncFormFields(wrap);
      },
      true
    );
  }

  // === TIER SELECTION / UI + DATA ===
  function setSelected(tier){
    var wrap = getMbbWrap();
    if (!wrap) return;

    var t = TIERS[tier] || TIERS[2];
    var priceData = PRICE_BY_TIER[tier] || PRICE_BY_TIER[2];
    var priceCents   = priceData.price   || 0;
    var compareCents = priceData.compare_at || 0;

    var cards = wrap.querySelectorAll('.mbb-card');
    cards.forEach(function(c){
      var is = (+c.getAttribute('data-tier') === +tier);
      c.classList.toggle('is-selected', is);
      c.setAttribute('aria-checked', is ? 'true' : 'false');
    });

    var compareEl = wrap.querySelector('[data-mbb-compare]');
    var totalEl   = wrap.querySelector('[data-mbb-total]');
    var saveEl    = wrap.querySelector('[data-mbb-save]');

    // V5: gifts UI removed — no gift unlock / odds-image swap to do.

    // Price bar: use actual variant price/compare_at (Markets-safe)
    if (totalEl){
      totalEl.textContent = formatMoney(priceCents);
    }

    // For tier 1 or when no real discount, hide compare/save
    var hasDiscount = tier !== 1 && compareCents > priceCents;
    console.log("discount: " + hasDiscount);

    if (!hasDiscount){
      if (compareEl) compareEl.style.display = 'none';
      if (saveEl)    saveEl.style.display    = 'none';
    } else {
      var savingsCents = compareCents - priceCents;
      console.log(savingsCents);

      if (compareEl){
        compareEl.style.display = '';
        compareEl.innerHTML = '<s>' + formatMoney(compareCents) + '</s>';
      }
      if (saveEl){
        saveEl.style.display = '';
        saveEl.textContent = "You're saving " + formatMoney(savingsCents);
      }
    }

    wrap.dataset.tier   = String(tier);

    syncFormFields(wrap);
  }

  // Default selection: Buy 2 Miners
  setSelected(2);

  // Delegation: survives section morphs that replace card nodes
  WRAP.addEventListener('click', function (ev) {
    var root = ev.currentTarget;
    var card = ev.target.closest('.mbb-card');
    if (!card || !root.contains(card)) return;
    setSelected(+card.getAttribute('data-tier'));
  });

  // V5: react to the Miner Type Selector switching active product.
  // Updates ACTIVE_MINER, then re-runs setSelected() with the current
  // tier so price bar + ATC variant ID reflect the new miner.
  document.addEventListener('mb:miner-changed', function (ev) {
    var handle = ev && ev.detail && ev.detail.handle;
    if (!handle || !MINER_DATA[handle]) {
      console.warn('[MB Bundle] Unknown miner handle:', handle);
      return;
    }
    if (handle === ACTIVE_MINER) return;
    ACTIVE_MINER = handle;

    var wrap = getMbbWrap();
    var currentTier = wrap ? (+wrap.dataset.tier || 2) : 2;
    setSelected(currentTier);
    console.log('[MB Bundle] Switched to miner:', handle, 'at tier', currentTier);
  });

  onReady(function(){
    syncFormFields();
  });

})();
</script>


{% schema %}
{
  "name": "Bundle Selector V5",
  "settings": [],
  "presets": [{ "name": "Bundle Selector V5" }]
}
{% endschema %}