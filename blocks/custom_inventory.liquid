<div class="custom-inventory-box section-{{ section.id }}-padding">
    <div class="custom-inventory-text">{{ block.settings.content }}</div>
</div>
<style>
    .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        background-color: {{ section.settings.back_color }};
    }
    @media screen and (max-width: 768px) {
        .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.mbl_padding_top }}px;
            padding-bottom: {{ section.settings.mbl_padding_bottom }}px;
        }
    }
</style>
{% schema %}
{
  "name": "Custom Inventory",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 10
    },
    {
      "type": "range",
      "id": "mbl_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "mbl_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 10
    },
    {
      "type": "color",
      "id": "back_color",
      "label": "Background Color"
    },    
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
    }, 
],
"presets": [
    {
      "name": "Custom Inventory",
    }
  ]
}
{% endschema %}
