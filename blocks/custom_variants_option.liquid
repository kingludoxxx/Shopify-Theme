<div class="bundle-save-wrapper">
  <div class="bundle-title">BUNDLE & SAVE</div>
  <!-- OPTION 1 -->
  <div class="bundle-option active">
    <div class="bundle-left">
      <img src="{{ block.settings.image1 | img_url : 'master' }}" alt="{{ block.settings.image1.alt }}">
      <div class="bundle-info">
        <h3>{{  block.settings.text1 }}</h3>
        <p>{{  block.settings.bt_text1 }}</p>
      </div>
    </div>

    <div class="bundle-right">
      <div class="bundle-price">{{ block.settings.bt_price1 }}</div>
      <div class="bundle-old-price">{{ block.settings.bt_Compare1 }}</div>
    </div>
  </div>
  <!-- OPTION 2 -->
  <div class="bundle-option">
    <div class="bundle-tag">Free Shipping</div>
    <div class="bundle-left">
      <img src="{{ block.settings.image2 | img_url : 'master' }}" alt="{{ block.settings.image2.alt }}">
      <div class="bundle-info">
        <h3> {{  block.settings.text2 }}
          {% comment %} <span class="bundle-badge">{{ block.settings.bt_text2 }}</span> {% endcomment %}
        </h3>
        <p>{{ block.settings.bt_text2 }}</p>
      </div>
    </div>
    <div class="bundle-right">
      <div class="bundle-price">{{  block.settings.bt_price2 }}</div>
      <div class="bundle-old-price">{{ block.settings.bt_Compare2 }}</div>
    </div>
  </div>
  <!-- OPTION 3 -->
  <div class="bundle-option">
    <div class="bundle-tag">HIGHEST CHANCES</div>
    <div class="bundle-left">
      <img src="{{ block.settings.image3 | img_url : 'master' }}" alt="{{ block.settings.image3.alt }}">
      <div class="bundle-info">
        <h3> {{ block.settings.text3 }}
          {% comment %} <span class="bundle-badge">{{ block.settings.bt_text3 }}</span> {% endcomment %}
        </h3>
        <p>{{ block.settings.bt_text3 }}</p>
      </div>
    </div>
    <div class="bundle-right">
      <div class="bundle-price">{{ block.settings.bt_price3 }}</div>
      <div class="bundle-old-price">{{ block.settings.bt_Compare3 }}</div>
    </div>
  </div>
</div>


<style>
.bundle-save-wrapper {max-width: 680px; margin: 20px auto;}
.bundle-title {
  display: flex;
  align-items: center;
  text-align: center;
  font-weight: 700;
  font-size: 34px;
  margin-bottom: 20px;
  color: #111;
}
.bundle-title::before,
.bundle-title::after {content: ""; flex: 1; border-bottom: 2px solid #d9d9d9;}
.bundle-title::before {margin-right: 15px;}
.bundle-title::after {margin-left: 15px;}
.bundle-option {
  border: 2px solid #222;
  border-radius: 14px;
  padding: 18px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  position: relative;
  background: #fff;
  cursor: pointer;
  transition: all 0.2s ease;
}
.bundle-option.active {background: #ededed;  box-shadow: inset 0 0 0 1px var(--bar-border-color, rgba(0, 0, 0, .3)); border: 2px solid #00000021;}
.bundle-option:hover {border-color: #000; transform: translateY(-1px);}
.bundle-left {display: flex; align-items: center; gap: 16px;}
.bundle-left img {width: 58px; height: auto;}
.bundle-info h3 {margin: 0; font-size: 20px;  line-height: 1.1; color: #111;}
.bundle-info p {margin: 6px 0 0; color: #555; font-size: 14px; font-weight: 500;}

{% comment %} .bundle-badge {
  display: inline-block;
  background: #e9e9e9;
  color: #333;
  font-size: 13px;
  padding: 4px 10px;
  border-radius: 999px;
  margin-left: 10px;
  vertical-align: middle;
  font-weight: 600;
} {% endcomment %}

.bundle-right { text-align: right;}
.bundle-price { font-size: 20px; line-height: 24px; font-weight: 600; color: #111;}
.bundle-old-price {
  font-size: 16px;
  line-height: 20px;
  color: #999;
  text-decoration: line-through;
  margin-top: 4px;
}

.bundle-tag {
    position: absolute;
    top: -14px;
    right: 18px;
    background: #1f5fff;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 8px;
}
</style>

<script>
document.querySelectorAll('.bundle-option').forEach(option => {
  option.addEventListener('click', () => {

    // remove active from all
    document.querySelectorAll('.bundle-option')
      .forEach(el => el.classList.remove('active'));

    // add active to clicked one
    option.classList.add('active');

  });
});
</script>

