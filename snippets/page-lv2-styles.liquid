<style data-page-lv2>
.template-page-lv2 #MainContent, .template-page-list-v2 #MainContent{max-width:760px;margin:0 auto;padding:0 24px;color:#1a1a1a;line-height:1.6;background:#fff;font-family:Charter,Cambria,Georgia,serif}
.template-page-lv2 #MainContent h1, .template-page-list-v2 #MainContent h1{font-size:38px;line-height:1.15;font-weight:800;letter-spacing:-.015em;margin:24px 0 18px;color:#111}
.template-page-lv2 #MainContent h2, .template-page-list-v2 #MainContent h2{font-size:28px;line-height:1.2;font-weight:800;letter-spacing:-.01em;margin:32px 0 12px;color:#111}
.template-page-lv2 #MainContent h3, .template-page-list-v2 #MainContent h3{font-size:22px;line-height:1.3;font-weight:700;margin:28px 0 10px;color:#111}
.template-page-lv2 #MainContent p, .template-page-list-v2 #MainContent p{font-size:17px;margin:0 0 18px;color:#2a2a2a}
.template-page-lv2 #MainContent strong, .template-page-list-v2 #MainContent strong{color:#111;font-weight:700}
.template-page-lv2 #MainContent em, .template-page-list-v2 #MainContent em{font-style:italic}
.template-page-lv2 #MainContent img, .template-page-list-v2 #MainContent img{max-width:100%;height:auto;border-radius:6px;display:block;margin:8px 0}
[id*="__daily_news_bar"]{background:#1a1a1a!important;width:100vw!important;margin-left:calc(50% - 50vw)!important;padding:0!important}
[id*="__daily_news_bar"] *{background:#1a1a1a!important}
[id*="__daily_news_bar"] p{color:#fff!important;margin:0!important;padding:14px 16px!important;text-align:center!important;font-weight:700!important;font-size:14px!important;letter-spacing:1.5px!important;text-transform:uppercase!important}
[id*="__article_hero"]{padding:32px 0 8px!important}
[id*="__article_hero"] h1{font-size:38px!important;line-height:1.15!important;font-weight:800!important;margin:0 0 18px!important;color:#111!important}
[id*="__article_hero"] p:nth-of-type(1){font-size:18px!important;line-height:1.55!important;color:#444!important;margin-bottom:14px!important}
[id*="__article_hero"] p:nth-of-type(2){font-size:13px!important;color:#888!important;margin:0!important}
[id*="__hero_image"]{padding:16px 0 24px!important;background:transparent!important}
[id*="__hero_image"] svg, [id*="__hero_image"] img[src*="placeholder"]{display:none!important}
[id*="__hero_image"] .media-block, [id*="__hero_image"] .media-block__background{background:#e8e8e8!important;border-radius:8px!important;min-height:300px!important;display:flex!important;align-items:center!important;justify-content:center!important;color:#888!important;font-size:14px!important}
[id*="__hero_image"] .media-block::before, [id*="__sub_img"] .media-block::before, [id*="__reason_"] .media-block::before, [id*="__testimonials_intro"] .media-block::before{content:"[ IMAGE PLACEHOLDER ]"!important;position:absolute!important;font-size:13px!important;color:#999!important;letter-spacing:1px!important}
[id*="__sub_img"] svg, [id*="__sub_img"] img[src*="placeholder"], [id*="__reason_"] svg, [id*="__reason_"] img[src*="placeholder"], [id*="__testimonials_intro"] svg, [id*="__testimonials_intro"] img[src*="placeholder"]{display:none!important}
[id*="__sub_img"] .media-block, [id*="__reason_"] .media-block, [id*="__testimonials_intro"] .media-block{background:#e8e8e8!important;border-radius:8px!important;min-height:220px!important;display:flex!important;align-items:center!important;justify-content:center!important;position:relative!important}
[id*="__body_"] p{font-size:17px!important;line-height:1.65!important;color:#2a2a2a!important;margin-bottom:18px!important}
[id*="__h2_"] h2{font-size:28px!important;font-weight:800!important;line-height:1.2!important;color:#111!important;margin:24px 0 14px!important}
[id*="__bullets"] p{font-size:16px!important;line-height:1.55!important;margin:10px 0!important}
[id*="__listicle_header"] h2{font-size:32px!important;font-weight:800!important;text-align:center!important;margin:32px 0 12px!important}
[id*="__reason_"] h3{font-size:22px!important;font-weight:700!important;line-height:1.25!important;color:#111!important;margin:28px 0 14px!important}
[id*="__reason_"] p{font-size:17px!important;line-height:1.6!important;margin-bottom:14px!important}
[id*="__quote_block"] p{font-size:19px!important;font-style:italic!important;color:#444!important;border-left:4px solid #1a1a1a!important;padding:8px 0 8px 18px!important;margin:16px 0!important;line-height:1.5!important}
[id*="__cta_block"]{display:none!important}
[id*="__cta_block"] p strong{color:#fff!important}
[id*="__top_reasons"] p{font-size:16px!important;line-height:1.55!important;margin:10px 0!important}
[id*="__testimonial_"] p:nth-of-type(1){font-weight:800!important;font-size:17px!important;margin-bottom:6px!important;color:#111!important}
[id*="__testimonial_"] p:nth-of-type(2){font-size:16px!important;color:#333!important;line-height:1.55!important;margin-bottom:8px!important}
[id*="__testimonial_"] p:nth-of-type(3){font-size:14px!important;color:#666!important;margin:0 0 28px!important}
[id*="__final_offer"] h2{font-size:28px!important;font-weight:800!important;margin:24px 0 12px!important;color:#111!important}
[id*="__final_offer"] p:nth-of-type(1){font-size:18px!important;font-weight:700!important;margin-bottom:18px!important}
[id*="__final_offer"] p:nth-last-of-type(2){display:none!important}
[id*="__final_offer"] p:nth-last-of-type(2) strong{color:#fff!important}
[id*="__final_offer"] p:last-of-type{text-align:center!important;font-size:14px!important;color:#666!important}
[id*="__footer_band"]{background:#000!important;color:#fff!important;width:100vw!important;margin-left:calc(50% - 50vw)!important;padding:60px 24px!important;margin-top:48px!important}
[id*="__footer_band"] *{color:#fff!important;background:transparent!important}
[id*="__footer_band"] > div{max-width:760px!important;margin:0 auto!important;padding:0!important}
[id*="__footer_band"] p{font-size:17px!important;line-height:1.6!important}
[id*="__footer_band"] p strong{font-size:22px!important;font-weight:800!important;display:block!important;margin-bottom:16px!important}
[id*="__footer_band"] p:nth-last-of-type(3){display:none!important}
[id*="__footer_band"] p:last-of-type{font-size:12px!important;color:#aaa!important;line-height:1.5!important;margin-top:24px!important}

.lv2-sticky{position:fixed;bottom:0;left:0;right:0;z-index:9999;background:#1a1a1a;color:#fff;box-shadow:0 -4px 16px rgba(0,0,0,.25);padding:10px 16px;display:flex;align-items:center;justify-content:center;gap:14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}
.lv2-sticky__label{flex:1;font-size:14px;line-height:1.3;color:#fff;max-width:380px}
.lv2-sticky__label strong{display:block;font-size:15px;font-weight:800;color:#fff;margin-bottom:2px}
.lv2-sticky__label em{font-style:normal;color:#9ce29c;font-weight:700}
.lv2-sticky__btn{display:inline-block;background:#2e7d32;color:#fff!important;padding:14px 24px;border-radius:6px;text-decoration:none;font-weight:800;font-size:15px;letter-spacing:.5px;text-transform:uppercase;white-space:nowrap;transition:background .15s ease;box-shadow:0 2px 6px rgba(46,125,50,.4)}
.lv2-sticky__btn:hover{background:#256528}
body.template-page-lv2,body.template-page-list-v2{padding-bottom:96px!important}
@media (max-width:600px){.lv2-sticky{flex-direction:column;gap:8px;padding:12px}.lv2-sticky__label{text-align:center;max-width:none}.lv2-sticky__btn{width:100%;padding:14px}}


.template-page-lv2 #MainContent p,.template-page-list-v2 #MainContent p{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif!important;color:#111111!important}
[id*="__hero_image"],[id*="__sub_img"]{padding:4px 0!important}
.template-page-lv2 #MainContent img,.template-page-list-v2 #MainContent img{margin:3px 0!important}

/* footer text white on black (override the dark body-p rule) */
.template-page-lv2 #MainContent [id*="__footer_band"] p,.template-page-list-v2 #MainContent [id*="__footer_band"] p,.template-page-lv2 #MainContent [id*="__footer_band"] p *,.template-page-list-v2 #MainContent [id*="__footer_band"] p *{color:#fff!important}
/* mobile: shrink the long headline to ~4-5 lines */
@media (max-width:600px){[id*="__article_hero"] h1,.template-page-lv2 #MainContent h1,.template-page-list-v2 #MainContent h1{font-size:24px!important;line-height:1.2!important;margin:14px 0 12px!important;letter-spacing:-.01em!important}}

/* widen the narrow reading column on the advertorial pages (theme is page-width-narrow) */
body.template-page-lv2,body.template-page-list-v2{--max-width--body-normal:44em!important;--max-width--body-narrow:44em!important}
@media (max-width:749px){body.template-page-lv2,body.template-page-list-v2{--max-width--body-normal:100%!important;--max-width--body-narrow:100%!important;--page-margin:16px!important}
body.template-page-lv2 .section--page-width,body.template-page-list-v2 .section--page-width{padding-left:16px!important;padding-right:16px!important}}
</style>
<div class="lv2-sticky">
  <a href="{% if template.suffix == 'lv2' or template.suffix == 'list-v2' %}/products/pdp-v4{% else %}#{% endif %}" class="lv2-sticky__btn">{% if template.suffix == 'lv2' or template.suffix == 'list-v2' %}Get 58% Off{% else %}[REPLACE — CTA]{% endif %}</a>
</div>
