{%- comment -%} BF26 real countdown (Claude, Nov 21 2026): ends Nov 30 11:59:59 PM PT. Remove after Dec 1. {%- endcomment -%}
<style>
.bfx-box{background:#fff;color:#000;border-radius:5px;min-width:40px;height:50px;text-align:center}
.bfx-box b{display:block;font-size:20px;font-weight:600}
.bfx-box i{display:block;font-size:8px;font-style:normal;font-weight:normal;margin-top:-2px}
.bfx-hide{display:none!important}
@media (max-width:767px){.countdown-banner{flex-wrap:wrap!important;row-gap:6px}.countdown-banner .promo-text{width:100%;white-space:normal!important}.bfx-box{min-width:32px;height:38px}.bfx-box b{font-size:16px}}
</style>
<script>
(function(){
  var END = Date.UTC(2026, 11, 1, 7, 59, 59);
  if (Date.now() >= END) return;
  function pad(n){ return ("0" + n).slice(-2); }
  function setup(){
    var top = document.getElementById("countdown");
    if (top && !top.getAttribute("data-bfx")) {
      top.setAttribute("data-bfx","1");
      var keep = document.createElement("div"); keep.className = "bfx-hide";
      ["hours","minutes","seconds"].forEach(function(id){ var e = document.getElementById(id); if (e) { e.removeAttribute("id"); } var d = document.createElement("div"); d.id = id; keep.appendChild(d); });
      top.innerHTML = '<div class="bfx-box"><b data-bfx-d>00</b><i>DAYS</i></div>:<div class="bfx-box"><b data-bfx-h>00</b><i>HRS</i></div>:<div class="bfx-box"><b data-bfx-m>00</b><i>MIN</i></div>:<div class="bfx-box"><b data-bfx-s>00</b><i>SEC</i></div>';
      top.appendChild(keep);
    }
    document.querySelectorAll("[data-countdown-timer]").forEach(function(t){
      if (t.getAttribute("data-bfx")) return;
      t.setAttribute("data-bfx","1");
      t.innerHTML = ['d','DAYS','h','HRS','m','MIN','s','SEC'].reduce(function(a,v,i,arr){ return i%2 ? a : a + '<div class="time-unit"><span class="time-number" data-bfx-'+v+'>00</span><span class="time-label">'+arr[i+1]+'</span></div>'; }, '');
    });
  }
  function tick(){
    var s = Math.max(0, Math.floor((END - Date.now()) / 1000));
    var v = {d: Math.floor(s/86400), h: Math.floor(s%86400/3600), m: Math.floor(s%3600/60), s: s%60};
    Object.keys(v).forEach(function(k){ document.querySelectorAll("[data-bfx-"+k+"]").forEach(function(e){ e.textContent = pad(v[k]); }); });
  }
  function go(){ setup(); tick(); setInterval(tick, 1000); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", go); else go();
})();
</script>
