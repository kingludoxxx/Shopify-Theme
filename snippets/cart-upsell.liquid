 

<style>
/* ===== UPSELL WRAPPER ===== */
.cart-upsell {
  margin-top: 30px;
}

.cart-upsell__title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 14px;
  color: #111;
  text-transform: capitalize;
}

/* ===== CARD ===== */
.cart-upsell__item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  background: #000;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 14px;
  position: relative;
}

/* ===== IMAGE ===== */
.cart-upsell__item img {
  width: 68px;
  height: 68px;
  object-fit: cover;
  border-radius: 10px;
  background: #111;
  flex-shrink: 0;
}

/* ===== INFO ===== */
.cart-upsell__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* ===== TOP ROW: name + price ===== */
.cart-upsell__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
}

.cart-upsell__name {
  font-size: 14px;
  font-weight: 600;
  color: #c8a461;
  margin: 0;
  line-height: 1.3;
}

.cart-upsell__desc {
  font-size: 12px;
  color: #aaa;
  line-height: 1.4;
  margin: 2px 0 0;
}

/* ===== PRICE ===== */
.cart-upsell__price {
  font-size: 14px;
  font-weight: 700;
  color: #c8a461;
  white-space: nowrap;
  text-align: right;
  flex-shrink: 0;
}

.cart-upsell__price del {
  display: block;
  font-size: 11px;
  color: #777;
  font-weight: 400;
}

/* ===== BOTTOM ROW: dropdown + button ===== */
.cart-upsell__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  gap: 8px;
}

/* ===== VARIANT DROPDOWN ===== */
.cart-upsell__variant {
  background: #111;
  border: 1px solid #333;
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 12px;
  color: #ddd;
  width: fit-content;
  outline: none;
  -webkit-appearance: auto;
}

/* ===== ADD BUTTON ===== */
.cart-upsell__add {
  background: #0a3d91;
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 8px 22px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.1s ease;
  white-space: nowrap;
  flex-shrink: 0;
}

.cart-upsell__add:hover {
  background: #082f70;
}

.cart-upsell__add:active {
  transform: scale(0.97);
}
</style>
{% assign upsell_collection = collections['upsell'] %}

{% if upsell_collection and cart.item_count > 0 %}
  <div class="cart-upsell" data-cart-upsell>
    <h3 class="cart-upsell__title">you may also like</h3>

    {% for product in upsell_collection.products limit: 3 %}
      {% assign variant = product.selected_or_first_available_variant %}

      <div class="cart-upsell__item" data-upsell-item>
        <img
          src="{{ variant.featured_image | default: product.featured_image | image_url: width: 120 }}"
          alt="{{ product.title }}"
          loading="lazy"
          data-upsell-image
        >

        <div class="cart-upsell__info">
          <div class="cart-upsell__top">
            <p class="cart-upsell__name">{{ product.title }}</p>
            <div class="cart-upsell__price">
              <span data-upsell-price>{{ variant.price | money }}</span>
              {% if variant.compare_at_price > variant.price %}
                <del data-upsell-compare>{{ variant.compare_at_price | money }}</del>
              {% endif %}
            </div>
          </div>

          <div class="cart-upsell__actions">
            {% if product.variants.size > 1 %}
              <select class="cart-upsell__variant" data-upsell-select>
                {% for v in product.variants %}
                  <option
                    value="{{ v.id }}"
                    data-image="{{ v.featured_image | default: product.featured_image | image_url: width: 120 }}"
                    data-price="{{ v.price | money }}"
                    data-compare="{{ v.compare_at_price | money }}"
                  >
                    {{ v.title }}
                  </option>
                {% endfor %}
              </select>
            {% else %}
              <span></span>
            {% endif %}
            <button
              class="cart-upsell__add button"
              data-variant-id="{{ variant.id }}"
              type="button"
              data-upsell-add
            >
              Add
            </button>
          </div>
        </div>
      </div>
    {% endfor %}

    {%- comment -%} ── Gamma Miner Upsell (hardcoded) ── {%- endcomment -%}
    {% assign gamma = all_products['bitaxe-gamma'] %}
    {% if gamma and gamma.available %}
      {% assign gamma_variant = gamma.selected_or_first_available_variant %}
      <div class="cart-upsell__item" data-upsell-item>
        <img
          src="{{ gamma_variant.featured_image | default: gamma.featured_image | image_url: width: 120 }}"
          alt="{{ gamma.title }}"
          loading="lazy"
          data-upsell-image
        >

        <div class="cart-upsell__info">
          <div class="cart-upsell__top">
            <p class="cart-upsell__name">{{ gamma.title }}</p>
            <div class="cart-upsell__price">
              <span data-upsell-price>{{ gamma_variant.price | money }}</span>
              {% if gamma_variant.compare_at_price > gamma_variant.price %}
                <del data-upsell-compare>{{ gamma_variant.compare_at_price | money }}</del>
              {% endif %}
            </div>
          </div>

          <p class="cart-upsell__desc">Boost your chances of winning by adding this upgraded miner to your order.</p>

          <div class="cart-upsell__actions">
            {% if gamma.variants.size > 1 %}
              <select class="cart-upsell__variant" data-upsell-select>
                {% for v in gamma.variants %}
                  <option
                    value="{{ v.id }}"
                    data-image="{{ v.featured_image | default: gamma.featured_image | image_url: width: 120 }}"
                    data-price="{{ v.price | money }}"
                    data-compare="{{ v.compare_at_price | money }}"
                  >
                    {{ v.title }}
                  </option>
                {% endfor %}
              </select>
            {% else %}
              <span></span>
            {% endif %}
            <button
              class="cart-upsell__add button"
              data-variant-id="{{ gamma_variant.id }}"
              type="button"
              data-upsell-add
            >
              Add
            </button>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
{% endif %}

<script>
(function(){
  if (window.__MB_CART_UPSELL__) return;
  window.__MB_CART_UPSELL__ = true;

  // Delegate from document so it survives drawer morphs/re-renders
  document.addEventListener('change', function(e) {
    if (!e.target.matches('[data-upsell-select]')) return;

    var select = e.target;
    var selectedOption = select.options[select.selectedIndex];
    var itemContainer = select.closest('[data-upsell-item]');
    if (!itemContainer) return;

    // 1. Update Image
    var newImage = selectedOption.getAttribute('data-image');
    var imgTag = itemContainer.querySelector('[data-upsell-image]');
    if (newImage && imgTag) {
      imgTag.src = newImage;
    }

    // 2. Update Add Button variant ID
    var addButton = itemContainer.querySelector('[data-upsell-add]');
    if (addButton) {
      addButton.setAttribute('data-variant-id', select.value);
    }

    // 3. Update Price dynamically
    var newPrice = selectedOption.getAttribute('data-price');
    var priceTag = itemContainer.querySelector('[data-upsell-price]');
    if (newPrice && priceTag) {
      priceTag.textContent = newPrice;
    }

    // 4. Update Compare-at price
    var newCompare = selectedOption.getAttribute('data-compare');
    var compareTag = itemContainer.querySelector('[data-upsell-compare]');
    if (compareTag && newCompare) {
      compareTag.textContent = newCompare;
    }
  });

  // Add to cart via AJAX — also delegated from document
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-upsell-add]');
    if (!btn) return;

    var variantId = btn.getAttribute('data-variant-id');
    if (!variantId) return;

    btn.textContent = 'Adding...';
    btn.style.opacity = '0.7';
    btn.style.pointerEvents = 'none';

    // Get section IDs for Section Rendering API
    var sectionIds = [];
    document.querySelectorAll('cart-items-component').forEach(function(el) {
      if (el.dataset && el.dataset.sectionId) {
        sectionIds.push(el.dataset.sectionId);
      }
    });

    var body = {
      items: [{ id: parseInt(variantId, 10), quantity: 1 }]
    };
    if (sectionIds.length > 0) {
      body.sections = sectionIds.join(',');
      body.sections_url = window.location.pathname;
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })
    .then(function(res){ return res.json(); })
    .then(function(response){
      btn.textContent = 'Add';
      btn.style.opacity = '1';
      btn.style.pointerEvents = '';

      // Let the theme morph the cart drawer with updated sections
      if (response.sections) {
        Object.keys(response.sections).forEach(function(sectionId) {
          var comp = document.querySelector('cart-items-component[data-section-id="' + sectionId + '"]');
          if (comp && comp.dispatchEvent) {
            comp.dispatchEvent(new CustomEvent('cart-update', {
              bubbles: true,
              detail: { data: response, sectionId: sectionId }
            }));
          }
        });
      }

      // Fallback: if no sections returned, just fetch fresh cart HTML
      if (!response.sections) {
        fetch(window.location.pathname + '?sections=' + sectionIds.join(','))
          .then(function(r){ return r.json(); })
          .then(function(sections) {
            sectionIds.forEach(function(sid) {
              if (sections[sid]) {
                var container = document.querySelector('[id="shopify-section-' + sid + '"]');
                if (container) container.innerHTML = sections[sid];
              }
            });
          });
      }

    })
    .catch(function(){
      btn.textContent = 'Add';
      btn.style.opacity = '1';
      btn.style.pointerEvents = '';
    });
  });
})();
</script>


