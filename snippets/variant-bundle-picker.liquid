{% liquid
  assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
  if button_background_brightness < 105
    assign strikethrough_color_mix = '#000'
  else
    assign strikethrough_color_mix = '#fff'
  endif
%}

<variant-picker
  class="variant-picker variant-picker--bundle spacing-style variant-picker--{{ block_settings.alignment }}"
  style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; {% render 'spacing-style', settings: block_settings %}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product_resource.id }}"
  data-block-id="{{ block.id }}"
  data-product-url="{{ product_resource.url }}"
  ref="mainVariantPicker"
  {% if product.id == product_resource.id %}
    data-template-product-match="true"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  <form class="variant-picker__form variant-picker__form--bundle">
    <div class="bundle-picker">
      <h3 class="bundle-picker__heading">
        <span class="bundle-picker__heading-line"></span>
        <span class="bundle-picker__heading-text">BUNDLE & SAVE</span>
        <span class="bundle-picker__heading-line"></span>
      </h3>

      <fieldset
        class="variant-option variant-option--bundle-cards"
        data-fieldset-index="0"
        ref="fieldsets[]"
      >
        <legend class="visually-hidden">{{ product_option.name | escape }}</legend>

        {%- for product_option_value in product_option.values -%}
          {%- assign v = product_option_value.variant -%}
          {%- assign savings = v.compare_at_price | minus: v.price -%}
          {%- assign is_selected = product_option_value.selected -%}
          {%- assign featured_media = v.featured_media | default: product_resource.featured_media -%}

          {%- comment -%} Hero-3 expander: tiers 4+ collapse behind "Need More?" toggle (product 15759810986315 only) {%- endcomment -%}
          {%- if product_resource.id == 15759810986315 and forloop.index == 4 -%}
            <button type="button" class="bundle-picker__more-toggle" data-more-toggle aria-expanded="false">
              <span class="bundle-picker__more-plus">+</span>
              <span class="bundle-picker__more-text">Need More? View More Options</span>
              <svg class="bundle-picker__more-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="bundle-picker__more-cards" data-more-cards hidden>
          {%- endif -%}
          <label
            class="bundle-picker__card{% if is_selected %} bundle-picker__card--selected{% endif %}"
          >
            <input
              type="radio"
              name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
              value="{{ product_option_value | escape }}"
              aria-label="{{ product_option_value.name }}"
              {% if product_option_value.available == false %}aria-disabled="true"{% endif %}
              data-previous-checked="false"
              data-fieldset-index="0"
              data-input-index="{{ forloop.index0 }}"
              data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
              data-option-value-id="{{ product_option_value.id }}"
              data-option-available="{{ product_option_value.available }}"
              data-connected-product-url="{{ product_option_value.product_url }}"
              {% if v.id %}data-variant-id="{{ v.id }}"{% endif %}
              {% if is_selected %}
                data-current-checked="true"
                checked
              {% else %}
                data-current-checked="false"
              {% endif %}
            >

            {%- comment -%} Top-right badge: Free Shipping (2nd), Best Value (3rd) {%- endcomment -%}
            {%- if forloop.index == 2 -%}
              <span class="bundle-picker__badge bundle-picker__badge--shipping">Free Shipping</span>
            {%- elsif forloop.index == 3 -%}
              {%- if product_resource.id == 15759810986315 -%}
                <span class="bundle-picker__badge bundle-picker__badge--value">Higher Chances to Win</span>
              {%- else -%}
                <span class="bundle-picker__badge bundle-picker__badge--value">Best Value</span>
              {%- endif -%}
            {%- endif -%}

            <div class="bundle-picker__card-inner">
