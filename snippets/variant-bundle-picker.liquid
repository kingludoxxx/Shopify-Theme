{%- comment -%}
  Hero-3 test (product 15759810986315 ONLY): pre-select the Buy 3 tier on
  page load. Clicking the radio (instead of setting `checked` in Liquid)
  runs the theme's own variant-change pipeline, so the main price, compare-at,
  media, and add-to-cart button all update consistently. Skipped when the URL
  already carries an explicit ?variant= (deep links keep working).
{%- endcomment -%}
{%- if product_resource.id == 15759810986315 -%}
  {%- comment -%}
    Hero-3 test styling: make the per-unit "each" price clearly visible
    (default is 14px gray). Emitted only on this product's page, so no
    other product's widget styling changes.
  {%- endcomment -%}
  <style>
    .bundle-picker__each {
      font-size: 13px !important;
      color: #6b6b6b !important;
      font-weight: 700 !important;
    }
    .bundle-picker__more-toggle {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      margin-top: 10px;
      padding: 14px 16px;
      background: transparent;
      border: 2px dashed #b5b5b5;
      border-radius: 14px;
      cursor: pointer;
      font-family: inherit;
    }
    .bundle-picker__more-plus {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border: 2px solid #1a61f9;
      border-radius: 50%;
      color: #1a61f9;
      font-size: 17px;
      font-weight: 800;
      line-height: 1;
    }
    .bundle-picker__more-text {
      flex: 1 1 auto;
      text-align: center;
      font-size: 15px;
      font-weight: 800;
      color: #111;
    }
    .bundle-picker__more-chevron {
      flex: 0 0 auto;
      color: #111;
      transition: transform 0.2s ease;
    }
    .bundle-picker__more-toggle.is-open .bundle-picker__more-chevron {
      transform: rotate(180deg);
    }
    .bundle-picker__more-cards {
      display: contents;
    }
    .bundle-picker__more-cards[hidden] {
      display: none;
    }
  </style>
  <script>
    (function () {
      // 1) Pre-select Buy 3 on load — ALWAYS (operator requirement), even when
      // the URL carries a ?variant= deep link. Retries for up to 5s in case
      // the picker inputs render late (section hydration / slow devices).
      var pickTries = 0;
      var pick = function () {
        var input = document.querySelector('input[data-variant-id="57455563473227"]');
        if (input) {
          if (!input.checked) input.click();
          return;
        }
        if (++pickTries < 25) setTimeout(pick, 200);
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', pick);
      } else {
        pick();
      }

      // Expander: "Need More? View More Options" reveals the Buy 6 / Buy 12
      // cards. The theme MORPHS the whole product section on every variant
      // change, which (a) restores the server-side collapsed state and
      // (b) replaces the toggle node, killing directly-attached listeners.
      // So: delegate the click at document level (survives node swaps),
      // remember the open state, and re-apply it after every DOM mutation.
      var moreOpen = false;
      var applyMoreState = function () {
        var toggle = document.querySelector('[data-more-toggle]');
        var cards = document.querySelector('[data-more-cards]');
        if (!toggle || !cards) return;
        if (moreOpen) {
          if (cards.hasAttribute('hidden')) cards.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.classList.add('is-open');
        } else {
          if (!cards.hasAttribute('hidden')) cards.setAttribute('hidden', '');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.classList.remove('is-open');
        }
      };
      document.addEventListener('click', function (e) {
        var t = e.target.closest('[data-more-toggle]');
        if (!t) return;
        e.preventDefault();
        moreOpen = !moreOpen;
        applyMoreState();
      });
      // Re-assert the expander state after the theme's section morphs.
      // rAF-debounced so bursts of mutations cost one pass.
      var morphScheduled = false;
      new MutationObserver(function () {
        if (morphScheduled || !moreOpen) return;
        morphScheduled = true;
        requestAnimationFrame(function () {
          morphScheduled = false;
          applyMoreState();
        });
      }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });

      // 2) Skip the cart drawer: intercept Add to Cart, then clear cart ->
      // add the selected variant -> window.proceedToCheckout(), which is the
      // injected MineBlock/Lasso checkout redirect (carries lasso_sid). This
      // mirrors the flow the Lasso landing pages use — the Whop+Lasso
      // checkout reads the Shopify cart, so the cart must contain exactly
      // the selected bundle. NOT Shopify's native /checkout (payments there
      // are intentionally disabled). Capture phase beats the theme's own
      // add-to-cart handler; whole block renders only for product
      // 15759810986315.
      document.addEventListener(
        'click',
        function (e) {
          // Never intercept clicks inside the bundle picker itself (variant
          // cards, expander toggle) — only the real Add to Cart button.
          if (e.target.closest('.bundle-picker, [data-more-toggle], [data-more-cards]')) return;
          var btn = e.target.closest(
            'form[action*="/cart/add"] button, product-form-component button[type="submit"], add-to-cart-component button'
          );
          if (!btn) return;
          // don't hijack accelerated-checkout wallet buttons
          if (btn.closest('shopify-accelerated-checkout, [data-shopify="payment-button"]')) return;
          e.preventDefault();
          e.stopPropagation();

          var checked = document.querySelector('input[data-variant-id]:checked');
          var variantId = checked
            ? checked.getAttribute('data-variant-id')
            : '57455563473227';

          var originalText = btn.textContent;
          btn.textContent = 'Loading...';
          btn.setAttribute('aria-busy', 'true');

          fetch('/cart/clear.js', { method: 'POST' })
            .then(function () {
              return fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] }),
              });
            })
            .then(function (res) {
              if (!res.ok) throw new Error('add-to-cart failed');
              if (typeof window.proceedToCheckout === 'function') {
                window.proceedToCheckout();
              } else {
                // Lasso script not loaded — fall back to the cart page where
                // the standard flow (and its checkout handling) takes over.
                window.location.href = '/cart';
              }
            })
            .catch(function () {
              btn.textContent = originalText;
              btn.removeAttribute('aria-busy');
              window.location.href = '/cart';
            });
        },
        true
      );
    })();
  </script>
{%- endif -%}
