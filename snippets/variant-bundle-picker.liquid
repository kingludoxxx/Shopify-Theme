                {% if savings > 0 and product_resource.id != 15538599559499 and product_resource.id != 15759810986315 and product_resource.id != 15626881532235 and product_resource.id != 15420770681163 and product_resource.id != 15698813452619 %}
                  <p class="bundle-picker__savings">You save {{ savings | money }}</p>
                {% endif %}
              </div>
              <div class="bundle-picker__card-price">
                <span class="bundle-picker__price-current">{{ v.price | money }}</span>
                {% if v.compare_at_price > v.price %}
                  <span class="bundle-picker__price-compare">{{ v.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </label>
        {%- endfor -%}
        {%- if product_resource.id == 15759810986315 -%}
          </div>
        {%- endif -%}
      </fieldset>
    </div>

    <script type="application/json">
      {{ product_resource.selected_or_first_available_variant | json }}
    </script>
  </form>
</variant-picker>

{% stylesheet %}
  .variant-picker--bundle .bundle-picker {
    width: 100%;
  }

  .bundle-picker__heading {
