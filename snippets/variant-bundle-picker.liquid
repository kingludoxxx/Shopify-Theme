    overflow: hidden;
  }

  .bundle-picker__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bundle-picker__card-body {
    flex: 1;
    min-width: 0;
  }

  .bundle-picker__card-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    line-height: 1;
  }

  .bundle-picker__card-title {
    font-size: 20px;
    font-weight: bold;
    color: rgb(var(--color-foreground-rgb));
  }

  .bundle-picker__pill {
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 8px;
    background-color: rgba(217, 217, 217, 1);
    color: black;
    font-weight: 900;
  }

  .bundle-picker__savings {
    margin: 0;
    font-size: 14px;
